---
import Arrow from '../components/Arrow.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout lang="en" title="Page not found" notFound={true}>
  <section class="section"><div class="wrap">
    <p class="eyebrow">404</p>
    <h1>Page not found</h1>
    <p class="lead mt-32" lang="hi">यह पेज नहीं मिला। स्कूल के मुखपृष्ठ से शुरू करें।</p>
    <div class="hero-actions">
      <a class="button button-primary" href="/en/">School homepage <Arrow/></a>
      <a class="button button-outline" href="/hi/" lang="hi">स्कूल का मुखपृष्ठ <Arrow/></a>
    </div>
  </div></section>
</SiteLayout>
