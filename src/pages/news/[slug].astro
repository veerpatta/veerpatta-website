---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHead from '../../components/PageHead.astro';
import {pick,pathFor,type Lang} from '../../data/site';
export function getStaticPaths(){return(['en','hi'] as const).map(lang=>({params:{slug:`2025-01-15-sports-day-${lang}`},props:{lang}}));}
const {lang}=Astro.props as {lang:Lang};
const t=(en:string,hi:string)=>pick(lang,en,hi);
const title=t('Annual Sports Day Celebration 2025','वार्षिक खेल दिवस समारोह 2025');
const date=t('15 January 2025','15 जनवरी 2025');
const description=t('Track and field events and a march past brought the school together. From the Veerpatta school archive.','दौड़, मैदानी खेलों और मार्च पास्ट के लिए पूरा स्कूल साथ आया। वीरपट्टा स्कूल के संग्रह से।');
---
<SiteLayout lang={lang} slug="news" title={title} canonicalPath={`/news/2025-01-15-sports-day-${lang}/`} description={description}>
 <article>
  <PageHead lang={lang} title={title} kicker={t('School archive','स्कूल का समाचार संग्रह')} description={description} links={[{href:pathFor(lang,'news')+'#archive',label:t('Back to the archive','समाचार संग्रह पर लौटें')}]}/>
  <section class="section inside-section"><div class="wrap prose news-story">
   <p class="eyebrow"><time datetime="2025-01-15">{date}</time></p>
   <h2>{t('Highlights from the day','दिन की झलकियाँ')}</h2>
   <ul class="sports-highlights">
    <li>{t('100m, 200m and relay races','100 मीटर, 200 मीटर और रिले दौड़')}</li>
    <li>{t('Shot put and long jump','गोला फेंक और लंबी कूद')}</li>
    <li>{t('March past by the school houses','स्कूल के सदनों का मार्च पास्ट')}</li>
    <li>{t('An award ceremony for young athletes','युवा खिलाड़ियों का सम्मान समारोह')}</li>
   </ul>
   <p>{t('Parents and guests joined the school community to cheer on the young athletes.','अभिभावक और अतिथि खिलाड़ियों का हौसला बढ़ाने के लिए स्कूल परिवार के साथ जुड़े।')}</p>
   <section class="inside-callout" aria-labelledby="current-dates"><div><h2 id="current-dates">{t('Looking for current dates?','वर्तमान तारीखें जानना चाहते हैं?')}</h2><p>{t('This story is from the archive, not an upcoming event notice. Ask the office for current dates.','यह पुराना समाचार है, आने वाले कार्यक्रम की सूचना नहीं। वर्तमान तारीखें स्कूल कार्यालय से पूछें।')}</p></div><a class="button button-outline" href={pathFor(lang,'contact')}>{t('Contact the office','कार्यालय से संपर्क करें')} <span aria-hidden="true">→</span></a></section>
  </div></section>
 </article>
</SiteLayout>
<style>
.news-story { max-width:980px; }
.sports-highlights { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr)); gap:.65rem; padding:0; list-style:none; }
.sports-highlights li { padding:.8rem 1rem; border-inline-start:3px solid #b97828; background:#f7f0e1; }
.news-story .inside-callout { margin-top:1.6rem; }
</style>
