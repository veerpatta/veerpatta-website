---
import SiteLayout from '../../layouts/SiteLayout.astro';
import {pick,pathFor,type Lang} from '../../data/site';
export function getStaticPaths(){return(['en','hi'] as const).map(lang=>({params:{slug:`2025-01-15-sports-day-${lang}`},props:{lang}}));}
const {lang}=Astro.props as {lang:Lang};
const title=pick(lang,'Annual Sports Day Celebration 2025','वार्षिक खेल दिवस समारोह 2025');
---
<SiteLayout lang={lang} slug="news" title={title} canonicalPath={`/news/2025-01-15-sports-day-${lang}/`}><article class="section"><div class="wrap prose"><a class="text-link" href={pathFor(lang,'news')}>← {pick(lang,'Back to the archive','संग्रह में वापस जाएँ')}</a><p class="eyebrow mt-32">{pick(lang,'School archive · 15 January 2025','स्कूल संग्रह · 15 जनवरी 2025')}</p><h1>{title}</h1><p class="lead mt-32">{pick(lang,'Shri Veer Patta Senior Secondary School celebrated its Annual Sports Day. Students from all classes participated in track and field events.','श्री वीर पट्टा सीनियर सेकेंडरी स्कूल ने अपना वार्षिक खेल दिवस मनाया। सभी कक्षाओं के छात्रों ने ट्रैक और फ़ील्ड की गतिविधियों में भाग लिया।')}</p><h2>{pick(lang,'From the day','दिन की झलकियाँ')}</h2><ul><li>{pick(lang,'100m, 200m and relay races','100 मीटर, 200 मीटर और रिले दौड़')}</li><li>{pick(lang,'Shot put and long jump competitions','गोला फेंक और लंबी कूद')}</li><li>{pick(lang,'March past by all houses','सभी सदनों का मार्च पास्ट')}</li><li>{pick(lang,'An award ceremony for young athletes','युवा खिलाड़ियों का सम्मान समारोह')}</li></ul><p>{pick(lang,'Parents and guests joined the school community to cheer for the young athletes. This is an archived article, not an upcoming event notice.','अभिभावक और अतिथि युवा खिलाड़ियों का उत्साह बढ़ाने आए। यह पुराना लेख है, आगामी कार्यक्रम की सूचना नहीं।')}</p></div></article></SiteLayout>
