---
import '../styles/site.css';
import {nativePhonePattern} from '../scripts/enquiry';
import {site,pick,pathFor,navigation,type Lang} from '../data/site';
interface Props {lang:Lang;slug?:string;title?:string;description?:string;canonicalPath?:string}
const {lang,slug='',title,description,canonicalPath}=Astro.props;
const name=pick(lang,site.name,site.nameHi);
const pageTitle=title?`${title} | ${name}`:pick(lang,'Veerpatta School, Amet | A place to learn. A world to discover.','वीरपट्टा स्कूल, आमेट | सीखने की जगह, नई संभावनाओं की दुनिया');
const desc=description||pick(lang,'Discover Veerpatta Senior Secondary School in Amet. RBSE, Nursery to Class 12, real campus photos, student life and simple admissions guidance.','आमेट के वीरपट्टा सीनियर सेकेंडरी स्कूल को जानें। आरबीएसई, नर्सरी से कक्षा 12, परिसर की असली तस्वीरें, स्कूल जीवन और आसान प्रवेश जानकारी।');
const canonical=site.url+(canonicalPath||pathFor(lang,slug));
const altLang=lang==='en'?'hi':'en';
const altPath=canonicalPath?canonicalPath.replace(/-(en|hi)\/$/,`-${altLang}/`):pathFor(altLang,slug);
const nav=navigation(lang);
---
<!doctype html>
<html lang={lang}>
 <head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title><meta name="description" content={desc} /><meta name="generator" content={Astro.generator} />
  <meta name="site-release" content={site.release} /><meta name="theme-color" content="#142c52" />
  <link rel="canonical" href={canonical} /><link rel="alternate" hreflang={lang} href={canonical} /><link rel="alternate" hreflang={altLang} href={site.url+altPath} /><link rel="alternate" hreflang="x-default" href={site.url+pathFor('en',slug)} />
  <link rel="icon" type="image/png" href="/assets/images/school-mark-48.png" /><link rel="manifest" href="/manifest.webmanifest" />
  <meta property="og:type" content="website" /><meta property="og:site_name" content={name} /><meta property="og:title" content={pageTitle} /><meta property="og:description" content={desc} /><meta property="og:url" content={canonical} /><meta property="og:image" content={`${site.url}/assets/media/photos/campus-lawn-1600.webp`} /><meta property="og:locale" content={lang==='hi'?'hi_IN':'en_IN'} /><meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'School',name:site.name,alternateName:site.fullName,url:site.url,telephone:site.phone,address:{'@type':'PostalAddress',streetAddress:'Opp. Mela Ground',addressLocality:'Amet',addressRegion:'Rajasthan',postalCode:'313332',addressCountry:'IN'}})} />
 </head>
 <body>
  <a class="skip-link" href="#main-content">{pick(lang,'Skip to content','मुख्य सामग्री पर जाएँ')}</a>
  <div class="topbar"><div class="wrap topbar-inner"><span>{pick(lang,'Amet, Rajasthan','आमेट, राजस्थान')}<span class="topbar-dot">·</span>{pick(lang,'RBSE · Nursery to XII','आरबीएसई · नर्सरी से 12वीं')}</span><a href={`tel:${site.phone}`}><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2C10 21 3 14 2 4.2A2 2 0 0 1 4 2h3l2 5-2 2a16 16 0 0 0 8 8l2-2 5 2Z"/></svg>{site.phoneDisplay}</a></div></div>
  <header class="site-header"><div class="wrap header-inner">
   <a class="brand" href={pathFor(lang)} aria-label={name}><img src="/assets/images/school-logo-120.webp" width="54" height="54" alt="" /><span><strong>{pick(lang,'VEERPATTA','वीरपट्टा')}</strong><span>{pick(lang,'Senior Secondary School','सीनियर सेकेंडरी स्कूल')}</span></span></a>
   <nav class="desktop-nav" aria-label={pick(lang,'Main navigation','मुख्य नेविगेशन')}>{nav.map(n=><a href={pathFor(lang,n.slug)} aria-current={slug===n.slug?'page':undefined}>{n.label}</a>)}</nav>
   <div class="header-actions"><a class="language-link" href={altPath} lang={altLang} hreflang={altLang} aria-label={pick(lang,'हिंदी में देखें','View in English')}>{pick(lang,'हिंदी','English')}</a><a class="header-admit button button-primary" href={pathFor(lang,'admissions')}>{pick(lang,'Admissions','प्रवेश')}<span aria-hidden="true">↗</span></a></div>
   <details class="mobile-menu" data-mobile-menu><summary aria-label={pick(lang,'Open navigation menu','नेविगेशन मेनू खोलें')}><span class="menu-lines" aria-hidden="true"></span><span>{pick(lang,'Menu','मेनू')}</span></summary><nav aria-label={pick(lang,'Mobile navigation','मोबाइल नेविगेशन')}>{nav.map(n=><a href={pathFor(lang,n.slug)} aria-current={slug===n.slug?'page':undefined}>{n.label}<span aria-hidden="true">↗</span></a>)}<a href={pathFor(lang,'admissions')}>{pick(lang,'Admissions','प्रवेश')}<span aria-hidden="true">↗</span></a><a href={pathFor(lang,'digital')}>{pick(lang,'Digital campus','डिजिटल कैंपस')}<span aria-hidden="true">↗</span></a><a href={pathFor(lang,'news')}>{pick(lang,'News & updates','समाचार')}<span aria-hidden="true">↗</span></a></nav></details>
  </div></header>
  <main id="main-content" tabindex="-1"><slot /></main>
  <section class="visit-banner"><div class="wrap visit-banner-inner"><div><p class="eyebrow">{pick(lang,'Come and say hello','आइए, हमसे मिलिए')}</p><h2>{pick(lang,'Your next chapter starts with a visit.','एक मुलाक़ात से शुरू हो नई कहानी।')}</h2><p>{pick(lang,'Walk around. Ask questions. Get to know us.','परिसर देखें। अपने सवाल पूछें। हमें जानें।')}</p></div><a href={pathFor(lang,'admissions')+'#enquiry'} data-enquiry-open class="button button-saffron">{pick(lang,'Plan a school visit','स्कूल आने की जानकारी लें')}<span aria-hidden="true">↗</span></a></div></section>
  <footer class="site-footer"><div class="wrap"><div class="footer-main"><div class="footer-brand"><a class="brand" href={pathFor(lang)}><img src="/assets/images/school-logo-120.webp" width="56" height="56" alt="" /><span><strong>{pick(lang,'VEERPATTA','वीरपट्टा')}</strong><span>{pick(lang,'Senior Secondary School','सीनियर सेकेंडरी स्कूल')}</span></span></a><p>{pick(lang,'Learning. Belonging. Becoming.','सीखना। जुड़ना। आगे बढ़ना।')}</p><p>{pick(lang,site.address,site.addressHi)}</p></div><div><h3>{pick(lang,'Explore','जानें')}</h3><a href={pathFor(lang,'about')}>{pick(lang,'Our school','हमारा स्कूल')}</a><a href={pathFor(lang,'academics')}>{pick(lang,'Academics','शिक्षा')}</a><a href={pathFor(lang,'beyond')}>{pick(lang,'Beyond the classroom','कक्षा से आगे')}</a><a href={pathFor(lang,'gallery')}>{pick(lang,'Photos & films','तस्वीरें और फ़िल्में')}</a></div><div><h3>{pick(lang,'For families','अभिभावकों के लिए')}</h3><a href={pathFor(lang,'admissions')}>{pick(lang,'Admissions','प्रवेश')}</a><a href={pathFor(lang,'digital')}>{pick(lang,'Digital campus','डिजिटल कैंपस')}</a><a href={pathFor(lang,'faq')}>{pick(lang,'Common questions','आम सवाल')}</a><a href={pathFor(lang,'news')}>{pick(lang,'News archive','समाचार संग्रह')}</a></div><div><h3>{pick(lang,'Let’s talk','बात करें')}</h3><a href={`tel:${site.phone}`}>{site.phoneDisplay}</a><a href={site.whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp <span aria-hidden="true">↗</span></a><a href={site.maps} target="_blank" rel="noopener noreferrer">{pick(lang,'Get directions','रास्ता देखें')} <span aria-hidden="true">↗</span></a><a href={pathFor(lang,'contact')}>{pick(lang,'Contact the office','कार्यालय से संपर्क')}</a></div></div><div class="footer-bottom"><span>© {new Date().getUTCFullYear()} {name}. {pick(lang,'Amet, Rajasthan.','आमेट, राजस्थान।')}</span><a href={pathFor(lang,'privacy')}>{pick(lang,'Privacy','गोपनीयता')}</a><a href={altPath} lang={altLang}>{pick(lang,'हिंदी में पढ़ें','Read in English')}</a></div></div></footer>
  <div class="mobile-contact"><a href={`tel:${site.phone}`}>{pick(lang,'Call school','स्कूल को कॉल करें')}</a><a href={pathFor(lang,'admissions')+'#enquiry'} data-enquiry-open>{pick(lang,'Ask about admission','प्रवेश के बारे में पूछें')}<span aria-hidden="true">↗</span></a></div>
  <dialog id="enquiry-dialog" class="enquiry-dialog" aria-labelledby="enquiry-title"><div class="dialog-inner"><button type="button" class="dialog-close" data-dialog-close aria-label={pick(lang,'Close enquiry','पूछताछ बंद करें')}>×</button><p class="eyebrow">{pick(lang,'A conversation, not a commitment','पहले बात करें, फिर निर्णय लें')}</p><h2 id="enquiry-title">{pick(lang,'Let’s get to know your family.','आइए, आपके परिवार को जानें।')}</h2><p>{pick(lang,'Ask about classes, fees or a campus visit. The office will confirm availability and next steps.','कक्षाओं, शुल्क या स्कूल आने के बारे में पूछें। उपलब्धता और अगले कदम कार्यालय से पक्का करें।')}</p><form action="https://formspree.io/f/xgveybpz" method="POST" class="enquiry-form"><input type="hidden" name="source" value="School website enquiry" /><div class="field"><label for="enquiry-parent">{pick(lang,'Parent / guardian name','अभिभावक का नाम')}</label><input id="enquiry-parent" name="parent" autocomplete="name" required maxlength="100" /></div><div class="form-grid"><div class="field"><label for="enquiry-phone">{pick(lang,'Mobile number','मोबाइल नंबर')}</label><input id="enquiry-phone" type="tel" name="phone" autocomplete="tel" inputmode="tel" pattern={nativePhonePattern} title={pick(lang,'Enter a 10-digit Indian mobile number, optionally with +91.','भारत का 10 अंकों वाला मोबाइल नंबर लिखें, चाहें तो +91 के साथ।')} required /></div><div class="field"><label for="enquiry-class">{pick(lang,'Class of interest','किस कक्षा के लिए')}</label><select id="enquiry-class" name="class" required><option value="">{pick(lang,'Choose a class','कक्षा चुनें')}</option><option>Nursery</option><option>LKG</option><option>UKG</option>{Array.from({length:12},(_,i)=><option value={`Class ${i+1}`}>{pick(lang,`Class ${i+1}`,`कक्षा ${i+1}`)}</option>)}</select></div></div><label class="consent"><input type="checkbox" name="consent" value="I agree" required /><span>{pick(lang,'I agree to share these details with the school through Formspree so the office can respond.','कार्यालय से उत्तर पाने के लिए मैं ये जानकारी Formspree के माध्यम से स्कूल के साथ साझा करने को सहमत हूँ।')} <a href={pathFor(lang,'privacy')}>{pick(lang,'Privacy policy','गोपनीयता नीति')}</a></span></label><button class="button button-primary" type="submit">{pick(lang,'Send enquiry','पूछताछ भेजें')} <span aria-hidden="true">↗</span></button></form><div class="dialog-alternative">{pick(lang,'Prefer a conversation?','सीधी बात करना चाहेंगे?')} <a href={site.whatsapp} target="_blank" rel="noopener noreferrer">{pick(lang,'Open WhatsApp','WhatsApp खोलें')} ↗</a></div></div></dialog>
  <dialog id="photo-dialog" class="photo-dialog" aria-labelledby="photo-dialog-caption"><button type="button" class="dialog-close" data-dialog-close aria-label={pick(lang,'Close photo','तस्वीर बंद करें')}>×</button><figure><img id="photo-dialog-image" alt="" width="1200" height="900" /><figcaption id="photo-dialog-caption"></figcaption></figure></dialog>
  <script>import '../scripts/site.ts';</script>
 </body>
</html>
