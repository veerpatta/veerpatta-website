---
import Arrow from '../components/Arrow.astro';
import { photos } from '../data/media';
import '../styles/site.css';
import '../styles/fieldbook.css';
import '../styles/school.css';
import ParentGuide from '../components/ParentGuide.astro';
import MeasurementConsent from '../components/MeasurementConsent.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import {site,pick,pathFor,navigation,whatsappUrl,admissionWhatsApp,type Lang} from '../data/site';
interface Props {lang:Lang;slug?:string;title?:string;description?:string;canonicalPath?:string;notFound?:boolean}
const {lang,slug='',title,description,canonicalPath,notFound=false}=Astro.props;
const name=pick(lang,site.name,site.nameHi);
const pageTitle=title?`${title} | ${name}`:pick(lang,'Veer Patta School, Amet | School life, admissions & campus visits','वीर पत्ता स्कूल, आमेट | स्कूल जीवन, प्रवेश और परिसर की मुलाक़ात');
const desc=description||pick(lang,'Meet Veer Patta pupils at their learning exhibition, on the sports field and around the Amet campus. RBSE, Nursery to Class 12. Explore admissions or plan a visit.','आमेट के वीर पत्ता विद्यालय में बच्चों की प्रदर्शनी, खेल दिवस और परिसर की झलक देखें। राजस्थान बोर्ड, नर्सरी से 12वीं तक। प्रवेश और विद्यालय आने की जानकारी लें।');
const canonical=site.url+(canonicalPath||pathFor(lang,slug));
const altLang=lang==='en'?'hi':'en';
const altPath=canonicalPath?canonicalPath.replace(/-(en|hi)\/$/,`-${altLang}/`):pathFor(altLang,slug);
const nav=navigation(lang);
const admissions=slug==='admissions'||slug.startsWith('admissions/');
const defaultPath=canonicalPath?canonicalPath.replace(/-(en|hi)\/$/,'-en/'):pathFor(slug==='admissions/pre-primary'||slug==='admissions/class-11'?'hi':'en',slug);
const sharePhotos: Record<string, string> = {
  '': 'exhibition-pupils-amet', about: 'school-lawn-cricket', academics: 'angle-wheel-demonstration',
  admissions: 'classroom-participation', 'admissions/pre-primary': 'junior-track-games-2025',
  'admissions/class-11': 'greenhouse-exhibition-group', beyond: 'sports-podium-amet', digital: 'student-headset-desk',
  gallery: 'interhouse-dance-lawn', contact: 'campus-approach', news: 'junior-track-games-2025',
};
const shareId = sharePhotos[slug] ?? 'amet-campus-terrace';
const share = photos[shareId];
const shareImage = `${shareId}-${share.w}`;
---
<!doctype html>
<html lang={lang}>
 <head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title><meta name="description" content={desc} /><meta name="generator" content={Astro.generator} />
  <meta name="site-release" content={site.release} /><meta name="theme-color" content="#172e40" />
  {notFound && <meta name="robots" content="noindex,follow" />}{!notFound && <><link rel="canonical" href={canonical} /><link rel="alternate" hreflang={lang} href={canonical} /><link rel="alternate" hreflang={altLang} href={site.url+altPath} /><link rel="alternate" hreflang="x-default" href={site.url+defaultPath} /></>}
  <link rel="icon" type="image/png" href="/assets/images/vpps-emblem-48.png" /><link rel="manifest" href="/manifest.webmanifest" />
  <meta property="og:type" content="website" /><meta property="og:site_name" content={name} /><meta property="og:title" content={pageTitle} /><meta property="og:description" content={desc} /><meta property="og:url" content={canonical} /><meta property="og:image" content={`${site.url}/assets/media/photos/${shareImage}.webp`} /><meta property="og:image:alt" content={share.alt[lang]} /><meta property="og:locale" content={lang==='hi'?'hi_IN':'en_IN'} /><meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'School',name:site.name,alternateName:site.fullName,url:site.url,telephone:site.phone,address:{'@type':'PostalAddress',streetAddress:'Opp. Mela Ground',addressLocality:'Amet',addressRegion:'Rajasthan',postalCode:'313332',addressCountry:'IN'}})} />
 </head>
 <body>
  <div class="nav-pending" data-nav-pending data-message={pick(lang,'Opening the next page…','अगला पृष्ठ खुल रहा है…')} aria-hidden="true" hidden><img width="40" height="45" alt="" data-wait-mark/><span>{pick(lang,'Opening page…','पृष्ठ खुल रहा है…')}</span></div><span class="sr-only" role="status" aria-live="polite" data-nav-announcement></span>
  <a class="skip-link" href="#main-content">{pick(lang,'Skip to content','मुख्य सामग्री पर जाएँ')}</a>
  <header class="site-header"><div class="wrap header-inner">
   <a class="brand" href={pathFor(lang)}><img src="/assets/images/vpps-emblem-144.webp" width="54" height="54" alt="" /><span><strong>{pick(lang,'VEER PATTA','वीर पत्ता')}</strong><span>{pick(lang,'Senior Secondary School','सीनियर सेकेंडरी स्कूल')}</span></span></a>
   <nav class="desktop-nav" aria-label={pick(lang,'Main navigation','मुख्य नेविगेशन')}>{nav.map(n=><a href={pathFor(lang,n.slug)} aria-current={slug===n.slug?'page':undefined}>{n.label}</a>)}</nav>
   <div class="header-actions"><a class="language-link" href={altPath} lang={altLang} hreflang={altLang} aria-label={pick(lang,'हिंदी में देखें','View in English')}>{pick(lang,'हिंदी','English')}</a><a class="header-admit button button-primary" aria-current={admissions?'page':undefined} href={pathFor(lang,'admissions')}>{pick(lang,'Admissions','प्रवेश')}<span aria-hidden="true"><Arrow/></span></a></div>
   <details class="mobile-menu" data-mobile-menu><summary aria-label={pick(lang,'School menu','स्कूल मेनू')}><span class="menu-lines" aria-hidden="true"></span><span>{pick(lang,'Menu','मेनू')}</span></summary><nav aria-label={pick(lang,'Mobile navigation','मोबाइल नेविगेशन')}>{nav.map(n=><a href={pathFor(lang,n.slug)} aria-current={slug===n.slug?'page':undefined}>{n.label}<span aria-hidden="true"><Arrow/></span></a>)}<a href={pathFor(lang,'admissions')}>{pick(lang,'Admissions','प्रवेश')}<span aria-hidden="true"><Arrow/></span></a><a href={pathFor(lang,'digital')}>{pick(lang,'Digital campus','डिजिटल कैंपस')}<span aria-hidden="true"><Arrow/></span></a><a href={pathFor(lang,'news')}>{pick(lang,'News & updates','समाचार')}<span aria-hidden="true"><Arrow/></span></a></nav></details>
  </div></header>
  <main id="main-content" tabindex="-1"><slot /></main>
  <ParentGuide lang={lang}/><MeasurementConsent lang={lang}/>
  <section class="visit-banner" aria-labelledby="shared-visit-title"><div class="wrap visit-banner-inner"><div><h2 id="shared-visit-title">{pick(lang,'Find us opposite Mela Ground', 'आमेट में मेला ग्राउंड के सामने')}</h2><p>{pick(lang,'Call the office before travelling so we can arrange a time to show you around.', 'आने से पहले कार्यालय में फ़ोन करके स्कूल देखने का समय तय कर लें।')}</p></div><a href={pathFor(lang,'contact')+'#visit'} class="button button-saffron">{pick(lang,'Plan a school visit','स्कूल आने की जानकारी लें')}<span aria-hidden="true"><Arrow/></span></a></div></section>
  <footer class="site-footer"><div class="wrap"><div class="footer-main"><div class="footer-brand"><a class="brand" href={pathFor(lang)}><img src="/assets/images/vpps-emblem-144.webp" width="56" height="56" alt="" /><span><strong>{pick(lang,'VEER PATTA','वीर पत्ता')}</strong><span>{pick(lang,'Senior Secondary School','सीनियर सेकेंडरी स्कूल')}</span></span></a><p>{pick(lang,'RBSE · Nursery to Class 12','आरबीएसई · नर्सरी से कक्षा 12 तक')}</p><p>{pick(lang,site.address,site.addressHi)}</p></div><div><h3>{pick(lang,'Explore','जानें')}</h3><a href={pathFor(lang,'about')}>{pick(lang,'Our school','हमारा स्कूल')}</a><a href={pathFor(lang,'academics')}>{pick(lang,'Academics','शिक्षा')}</a><a href={pathFor(lang,'beyond')}>{pick(lang,'Beyond the classroom','कक्षा से आगे')}</a><a href={pathFor(lang,'gallery')}>{pick(lang,'Photos & films','तस्वीरें और फ़िल्में')}</a></div><div><h3>{pick(lang,'For families','अभिभावकों के लिए')}</h3><a href={pathFor(lang,'admissions')}>{pick(lang,'Admissions','प्रवेश')}</a><a href={pathFor(lang,'digital')}>{pick(lang,'Digital campus','डिजिटल कैंपस')}</a><a href={pathFor(lang,'faq')}>{pick(lang,'Common questions','आम सवाल')}</a><a href={pathFor(lang,'news')}>{pick(lang,'News archive','समाचार संग्रह')}</a></div><div><h3>{pick(lang,'Let’s talk','बात करें')}</h3><a href={`tel:${site.phone}`}>{site.phoneDisplay}</a><a href={whatsappUrl()} target="_blank" rel="noopener noreferrer">WhatsApp · <span dir="ltr">{site.whatsappDisplay}</span></a><a href={site.maps} target="_blank" rel="noopener noreferrer">{pick(lang,'Get directions','रास्ता देखें')} <span aria-hidden="true"><Arrow/></span></a><a href={pathFor(lang,'contact')}>{pick(lang,'Contact the office','कार्यालय से संपर्क')}</a></div></div><div class="footer-bottom"><span>© {new Date().getUTCFullYear()} {name}. {pick(lang,'Amet, Rajasthan.','आमेट, राजस्थान।')}</span><a href={pathFor(lang,'privacy')}>{pick(lang,'Privacy','गोपनीयता')}</a><a href={altPath} lang={altLang}>{pick(lang,'हिंदी में पढ़ें','Read in English')}</a></div></div></footer>
  <nav class="mobile-contact" aria-label={pick(lang,'Quick contact','झटपट संपर्क')}><a href={`tel:${site.phone}`}>{pick(lang,'Call school','स्कूल को कॉल करें')}</a><a class="mobile-whatsapp" href={admissionWhatsApp(lang)} target="_blank" rel="noopener noreferrer" data-whatsapp-enquiry><WhatsAppIcon size={18} />{pick(lang,'Ask on WhatsApp','WhatsApp पर पूछें')}</a></nav>
  <dialog id="photo-dialog" class="photo-dialog" aria-labelledby="photo-dialog-caption"><button type="button" class="dialog-close" data-dialog-close aria-label={pick(lang,'Close photo','तस्वीर बंद करें')}>×</button><figure><img id="photo-dialog-image" alt="" width="1200" height="900" /><figcaption id="photo-dialog-caption"></figcaption></figure></dialog>
  <script>import '../scripts/site.ts';import '../scripts/navigation-pending';</script>
 </body>
</html>
