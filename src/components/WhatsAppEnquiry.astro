---
import { type AdmissionClass } from '../data/admission-classes';
import { admissionWhatsApp, pick, site, type Lang } from '../data/site';
import WhatsAppIcon from './WhatsAppIcon.astro';

interface Props { lang: Lang; grade?: AdmissionClass; headingId?: string }
const { lang, grade, headingId = 'enquiry-heading' } = Astro.props;
const t = (en: string, hi: string) => pick(lang, en, hi);
---

<div class="wrap wa-layout">
  <div class="wa-copy">
    <h2 id={headingId}>{t('What happens in the chat?', 'WhatsApp पर आगे क्या होगा?')}</h2>
    <p>{t('When you send the draft, the school receives your message from your WhatsApp number. Please leave out your child’s name, marks and documents.', 'संदेश भेजने पर वह आपके WhatsApp नंबर से स्कूल को मिलता है। उसमें बच्चे का नाम, अंक या दस्तावेज़ न भेजें।')}</p>
    <p>{t('The office can confirm fees, availability and a time to visit.', 'फ़ीस, कक्षा में जगह और मुलाक़ात के समय की पुष्टि कार्यालय से करें।')}</p>
  </div>
  <div class="wa-card">
    <ol class="wa-steps">
      <li><strong>{t('Give permission for a call', 'फ़ोन पर संपर्क की अनुमति दें')}</strong><p>{t('The chat asks a parent or guardian aged 18 or over whether the office may call this number. You can agree or decline.', 'चैट में 18 वर्ष या उससे अधिक उम्र के माता-पिता या अभिभावक से पूछा जाता है कि क्या कार्यालय इस नंबर पर फ़ोन कर सकता है। आप हाँ या नहीं चुन सकते हैं।')}</p></li>
      <li><strong>{t('Check the class', 'कक्षा जाँचें')}</strong><p>{t('Check the class shown, or enter one if you started a general enquiry. You can change the class before confirming.', 'दिखाई गई कक्षा जाँचें। यदि आपने बिना कक्षा चुने पूछताछ शुरू की है, तो कक्षा लिखें। पुष्टि करने से पहले उसे बदल सकते हैं।')}</p></li>
      <li><strong>{t('Send the enquiry', 'पूछताछ भेजें')}</strong><p>{t('When the details are right, choose “Send enquiry” to request a call from the office.', 'विवरण सही होने पर कार्यालय से फ़ोन का अनुरोध करने के लिए “पूछताछ भेजें” चुनें।')}</p></li>
    </ol>
    <div class="wa-contact">
      <a class="button button-whatsapp" href={admissionWhatsApp(lang, grade)} target="_blank" rel="noopener noreferrer"
        data-whatsapp-enquiry data-admission-class={grade}><WhatsAppIcon />{t('Enquire on WhatsApp', 'WhatsApp पर पूछताछ करें')}</a>
      <span>{t('School WhatsApp', 'स्कूल का WhatsApp')} <bdi>{site.whatsappDisplay}</bdi></span>
    </div>
    <a class="wa-call" href={`tel:${site.phone}`}>{t('Call the office', 'कार्यालय को फ़ोन करें')} <bdi>{site.phoneDisplay}</bdi></a>
  </div>
</div>

<style>
  .wa-layout { display: grid; align-items: start; gap: 1.6rem 5vw; }
  .wa-copy h2 { max-width: 15ch; }
  .wa-copy p { margin-top: .9rem; max-width: 44ch; }
  .wa-card { padding: clamp(1.15rem, 3.2vw, 2.25rem); background: var(--paper, #fffcf5); border: 1px solid var(--line, #d8cec0); border-radius: .4rem; }
  .wa-steps { margin: 0; padding-left: 1.55rem; }
  .wa-steps li { padding-left: .4rem; }
  .wa-steps li + li { margin-top: 1rem; }
  .wa-steps li::marker { color: var(--blue); font-weight: 750; }
  .wa-steps strong { font-size: 1.07rem; }
  .wa-steps p { line-height: 1.6; margin-top: .1rem; }
  .wa-contact { display: flex; flex-wrap: wrap; align-items: center; gap: .55rem 1rem; border-top: 1px solid var(--line, #d8cec0); margin-top: 1.25rem; padding-top: 1.15rem; }
  .wa-contact > span { font-size: .84rem; }
  .wa-contact bdi, .wa-call bdi { white-space: nowrap; }
  .wa-call { display: inline-flex; align-items: center; flex-wrap: wrap; gap: .2rem .45rem; min-height: 44px; margin-top: .35rem; font-size: .92rem; font-weight: 650; text-decoration: underline; text-underline-offset: .19em; }
  @media (min-width: 850px) { .wa-layout { grid-template-columns: minmax(0, .85fr) minmax(0, 1.4fr); } }
  @media print { .wa-contact .button { display: none; } }
</style>
