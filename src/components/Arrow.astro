---
interface Props { direction?: 'right' | 'up-right' | 'down' }
const { direction = 'right' } = Astro.props;
const paths = {
  right: 'M3 10h13m-5-5 5 5-5 5',
  'up-right': 'M4 16 15 5M6 5h9v9',
  down: 'M10 3v13m-5-5 5 5 5-5',
};
---
<svg class="link-arrow" viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d={paths[direction]} /></svg>
