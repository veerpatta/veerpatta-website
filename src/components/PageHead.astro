---
import Arrow from './Arrow.astro';
import { pathFor, pick, type Lang } from '../data/site';
import '../styles/interior.css';
import Photo from './Photo.astro';

interface Props {
  lang: Lang;
  kicker: string;
  title: string;
  description: string;
  image?: string;
  caption?: string;
  links?: { href: string; label: string; external?: boolean }[];
}

const { lang, kicker, title, description, image, caption, links = [] } = Astro.props;
---
<header class:list={['inside-head', { 'inside-head--photo': image }]}>
  <div class="wrap">
    <nav class="inside-breadcrumb" aria-label={pick(lang, 'Breadcrumb', 'पृष्ठ का क्रम')}>
      <ol>
        <li><a href={pathFor(lang)}>{pick(lang, 'Home', 'मुखपृष्ठ')}</a></li>
        <li><span class="inside-breadcrumb__slash" aria-hidden="true">/</span><span aria-current="page">{kicker}</span></li>
      </ol>
    </nav>
    <div class="inside-head__grid">
      <div class="inside-head__copy">
        <h1>{title}</h1>
        <p class="inside-lead">{description}</p>
        {links.length > 0 && (
          <div class="inside-actions">
            {links.map((link, index) => (
              <a
                class={index === 0 ? 'button button-primary inside-primary' : 'inside-link'}
                href={link.href}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
              >
                {link.label}<span aria-hidden="true"><Arrow direction={link.href.startsWith('#') ? 'down' : link.external ? 'up-right' : 'right'}/></span>
              </a>
            ))}
          </div>
        )}
      </div>
      {image && (
        <figure class="inside-head__media">
          <Photo id={image} lang={lang} eager sizes="(min-width: 1350px) 650px, (min-width: 770px) 48vw, 94vw" />
          {caption && <figcaption>{caption}</figcaption>}
        </figure>
      )}
    </div>
  </div>
</header>
