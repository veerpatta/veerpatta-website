---
import Arrow from './Arrow.astro';
import { pageContent, schoolFaqs } from '../data/content';
import { admissionWhatsApp, pathFor, pick, site, type Lang, type PageSlug } from '../data/site';
import { measurementReady } from '../scripts/measurement';
import Admissions from './Admissions.astro';
import Learning from './Learning.astro';
import OurSchool from './OurSchool.astro';
import PageHead from './PageHead.astro';
import Photo from './Photo.astro';
import SchoolLife from './SchoolLife.astro';
import VisitGuide from './VisitGuide.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';

interface Props { lang: Lang; slug: PageSlug }
const { lang, slug } = Astro.props;
const t = (en: string, hi: string) => pick(lang, en, hi);
const page = pageContent[slug];
const link = (href: string, en: string, hi: string) => ({ href, label: t(en, hi) });
const pageLinks = {
  about: [
    link('#campus', 'Pupils at work and play', 'पढ़ाई और खेल की झलक'),
    link(pathFor(lang, 'contact') + '#visit', 'Plan a visit', 'आने की जानकारी'),
  ],
  academics: [
    link('#stages', 'Find your class', 'अपनी कक्षा देखें'),
    link('#elga', 'English in primary school', 'प्राथमिक कक्षाओं में अंग्रेज़ी'),
    link('#results', '2026 board results', 'बोर्ड परिणाम 2026'),
  ],
  admissions: [],
  beyond: [
    link('#school-activities', 'Sport and dance', 'खेल और नृत्य'),
    link('#houses', 'Meet the houses', 'चारों सदन देखें'),
    link('#ncc', 'NCC', 'एनसीसी'),
  ],
  digital: [
    link('#parent-help', 'Find help with a school link', 'स्कूल के लिंक की जानकारी लें'),
  ],
  contact: [
    link('tel:' + site.phone, 'Call ' + site.phoneDisplay, 'फ़ोन करें ' + site.phoneDisplay),
    link('#visit', 'Directions to the campus', 'विद्यालय का रास्ता'),
  ],
  faq: [
    link('#admissions-and-fees', 'Admissions & fees', 'प्रवेश और शुल्क'),
    link('#classes-and-visits', 'Classes & visits', 'कक्षाएँ और परिसर'),
    link('#current-families', 'Current families', 'वर्तमान अभिभावक'),
  ],
  privacy: [
    link('#your-details', 'Admission enquiries', 'प्रवेश पूछताछ'),
    link('#providers', 'External services', 'बाहरी सेवाएँ'),
    link('#your-choices', 'Corrections & photographs', 'सुधार और तस्वीरें'),
  ],
  news: [],
};

const faqGroups = [
  {
    id: 'admissions-and-fees',
    title: t('Admissions, fees and documents', 'प्रवेश, शुल्क और दस्तावेज़'),
    destination: link(pathFor(lang, 'admissions') + '#classes', 'Enquire about your class', 'अपनी कक्षा के बारे में पूछें'),
  },
  {
    id: 'classes-and-visits',
    title: t('Classes, transport and visits', 'कक्षाएँ, परिवहन और परिसर'),
    destination: link(pathFor(lang, 'contact') + '#visit', 'See the address and directions', 'पता और रास्ता देखें'),
  },
  {
    id: 'current-families',
    title: t('For current families', 'वर्तमान अभिभावकों के लिए'),
    destination: link(pathFor(lang, 'digital'), 'School links and logins', 'विद्यालय के लिंक और लॉगिन'),
  },
];
const services = [
  {
    name: t('Class notices', 'कक्षा की सूचनाएँ'),
    text: t('For a timetable change, holiday or meeting, ask the office which channel your class currently uses for notices.', 'समय-सारणी में बदलाव, छुट्टी या बैठक की सूचना के लिए कार्यालय से पूछें कि आपकी कक्षा को सूचना किस माध्यम से मिलती है।'),
  },
  {
    name: t('Parent login', 'अभिभावक लॉगिन'),
    text: t('Ask the office for the current app or login address and help signing in. Keep your password and one-time passcodes private.', 'ऐप या लॉगिन का वर्तमान पता और उसे खोलने में सहायता कार्यालय से लें। पासवर्ड और ओटीपी अपने पास रखें।'),
  },
  {
    name: t('Fee payments', 'शुल्क भुगतान'),
    text: t('Before paying, confirm the amount, recipient and accepted payment method with the office. Keep the receipt for your records.', 'शुल्क जमा करने से पहले राशि, प्राप्तकर्ता और भुगतान के तरीके की पुष्टि कार्यालय से करें। रसीद अपने पास रखें।'),
  },
];
---
{slug !== 'admissions' && (
  <div class="inside-article-head">
  <PageHead lang={lang} kicker={page.kicker[lang]} title={page.title[lang]}
    description={page.description[lang]} image={page.image} caption={page.caption?.[lang]}
    links={pageLinks[slug]} />
  </div>
)}

{slug === 'admissions' && <Admissions lang={lang} />}
{slug === 'about' && <OurSchool lang={lang} />}
{slug === 'academics' && <Learning lang={lang} />}
{slug === 'beyond' && <SchoolLife lang={lang} />}

{slug === 'digital' && (
  <>
    <section class="inside-section" id="parent-help" aria-labelledby="parent-help-title">
      <div class="wrap">
        <div class="inside-section-head">
          <h2 id="parent-help-title">{t('Getting the right school link', 'विद्यालय का सही लिंक कैसे लें')}</h2>
          <a class="inside-link" href={pathFor(lang, 'contact')}>{t('Contact the office', 'कार्यालय से संपर्क करें')}<span aria-hidden="true"><Arrow/></span></a>
        </div>
        <dl class="inside-service-list">
          {services.map(service => <div><dt>{service.name}</dt><dd>{service.text}</dd></div>)}
        </dl>
      </div>
    </section>
    <section id="computer-learning" class="inside-section inside-soft" aria-labelledby="computer-title">
      <div class="wrap">
        <div class="inside-section-head">
          <h2 id="computer-title">{t('A pupil’s quiz and a teacher workshop', 'विद्यार्थी का क्विज़ और शिक्षकों की कार्यशाला')}</h2>
          <a class="inside-link" href={pathFor(lang, 'academics') + '#exhibitions'}>{t('See pupil projects', 'बच्चों के प्रोजेक्ट देखें')}<span aria-hidden="true"><Arrow/></span></a>
        </div>
        <div class="inside-life-pair">
          <figure class="inside-figure inside-photo-story">
            <Photo id="tablet-quiz" lang={lang} phoneMaxWidth={800} sizes="(min-width: 1260px) 585px, (min-width: 770px) 47vw, 94vw" />
            <figcaption><strong>{t('Time’s up on the tablet', 'टैबलेट पर क्विज़ का समय पूरा')}</strong><span>{t('At the learning exhibition, a pupil holds a tablet towards the people gathered at the table. A red timer fills the screen at the end of the quiz.', 'विद्यालय की प्रदर्शनी में एक विद्यार्थी मेज़ के पास खड़े लोगों को टैबलेट दिखा रहा है। क्विज़ का समय पूरा होने पर स्क्रीन पर लाल रंग का टाइमर दिखता है।')}</span></figcaption>
          </figure>
          <figure class="inside-figure inside-photo-story">
            <Photo id="robotics-circuit" lang={lang} phoneMaxWidth={640} sizes="(min-width: 1260px) 585px, (min-width: 770px) 47vw, 94vw" />
            <figcaption><strong>{t('At a teacher workshop', 'शिक्षकों की कार्यशाला में')}</strong><span>{t('Coloured wires join an Arduino board, a breadboard and a sensor. Teachers worked with this circuit during a robotics training session in 2026.', 'रंगीन तारों से एक आर्डुइनो बोर्ड, ब्रेडबोर्ड और सेंसर जुड़े हैं। 2026 की रोबोटिक्स कार्यशाला में शिक्षकों ने इसी सर्किट पर काम किया।')}</span></figcaption>
          </figure>
        </div>
      </div>
    </section>
  </>
)}

{slug === 'contact' && (
  <>
    <section class="inside-section" aria-labelledby="contact-options-title">
      <div class="wrap">
        <div class="inside-section-head"><h2 id="contact-options-title">{t('Speak with the office', 'कार्यालय से बात करें')}</h2></div>
        <div class="inside-contact">
          <article>
            <h3>{t('School office', 'विद्यालय कार्यालय')}</h3>
            <a class="inside-contact__number" dir="ltr" href={'tel:' + site.phone}>{site.phoneDisplay}</a>
            <p>{t('For fees, subject choices, transport routes or a time to visit, call the office.', 'शुल्क, विषयों के विकल्प, बस के मार्ग या मिलने के समय के लिए कार्यालय में फ़ोन करें।')}</p>
          </article>
          <article>
            <h3>{t('Admissions on WhatsApp', 'WhatsApp पर प्रवेश पूछताछ')}</h3>
            <p class="inside-contact__number" dir="ltr">{site.whatsappDisplay}</p>
            <p>{t('Send an admission enquiry and choose the class you are interested in. The chat asks an adult to agree to a call back.', 'प्रवेश की पूछताछ भेजकर इच्छित कक्षा चुनें। चैट में किसी वयस्क से फ़ोन पर बात करने की सहमति ली जाती है।')}</p>
            <a class="button button-whatsapp" href={admissionWhatsApp(lang)} target="_blank" rel="noopener noreferrer" data-whatsapp-enquiry>
              <WhatsAppIcon />{t('Enquire on WhatsApp', 'WhatsApp पर पूछताछ करें')}
            </a>
          </article>
        </div>
      </div>
    </section>
    <VisitGuide lang={lang} />
  </>
)}

{slug === 'faq' && (
  <div class="inside-section">
    <div class="wrap inside-reading">
      {faqGroups.map(group => (
        <section class="inside-faq-group" id={group.id} aria-labelledby={group.id + '-heading'}>
          <h2 id={group.id + '-heading'}>{group.title}</h2>
          <div class="inside-faq-list">
            {schoolFaqs.filter(faq => faq.group === group.id).map(faq => (
              <details>
                <summary>{faq.q[lang]}<span class="inside-faq-mark" aria-hidden="true"></span></summary>
                <p>{faq.a[lang]}</p>
              </details>
            ))}
          </div>
          <a class="inside-link" href={group.destination.href}>{group.destination.label}<span aria-hidden="true"><Arrow/></span></a>
        </section>
      ))}
    </div>
  </div>
)}

{slug === 'privacy' && (
  <div class="inside-section">
    <div class="wrap inside-reading inside-policy">
      <section id="your-details">
        <h2>{t('Admission enquiries', 'प्रवेश की पूछताछ')}</h2>
        <p>{t('Choosing a class or an enquiry link opens a draft in WhatsApp. Opening the draft sends nothing. When you send it, the school can see your WhatsApp number, the class you included and the contents of your message. The chat asks an adult to agree before the office arranges a call back.', 'कक्षा या पूछताछ का लिंक चुनने पर WhatsApp में एक संदेश का मसौदा खुलता है। केवल मसौदा खोलने से संदेश नहीं जाता। जब आप भेजते हैं, विद्यालय को आपका WhatsApp नंबर, लिखी हुई कक्षा और संदेश की सामग्री दिखती है। फ़ोन पर संपर्क की व्यवस्था से पहले चैट में किसी वयस्क की सहमति ली जाती है।')}</p>
        <p>{t('For a first enquiry, leave out the child’s full name, birth date, marks and identity documents. You can call the office to ask how to provide documents later.', 'पहली पूछताछ में बच्चे का पूरा नाम, जन्मतिथि, अंक या पहचान के दस्तावेज़ न भेजें। बाद में दस्तावेज़ कैसे देने हैं, यह कार्यालय में फ़ोन करके पूछ सकते हैं।')}</p>
      </section>
      <section id="providers">
        <h2>{t('WhatsApp and external services', 'WhatsApp और बाहरी सेवाएँ')}</h2>
        <p>{t('The school’s WhatsApp service and its office staff handle the messages you send. WhatsApp processes messages and related information under its privacy policy. The website itself has no admission form.', 'आपके भेजे संदेश विद्यालय की WhatsApp सेवा और कार्यालय के कर्मचारी देखते हैं। WhatsApp अपनी गोपनीयता नीति के अनुसार संदेश और उनसे जुड़ी जानकारी सँभालता है। इस वेबसाइट पर प्रवेश फ़ॉर्म नहीं है।')}</p>
        <a class="inside-link" href="https://www.whatsapp.com/legal/privacy-policy" target="_blank" rel="noopener noreferrer">
          {t('WhatsApp privacy policy', 'WhatsApp की गोपनीयता नीति')}<span aria-hidden="true"><Arrow direction="up-right"/></span>
        </a>
        <p>{t('Choosing a directions link opens Google Maps. A social-media link in the news archive opens Instagram. Those services receive your visit when you follow the link.', 'रास्ते का लिंक चुनने पर Google Maps खुलता है। समाचार संग्रह का सोशल मीडिया लिंक Instagram खोलता है। इन सेवाओं को आपकी विज़िट की जानकारी तब मिलती है जब आप लिंक खोलते हैं।')}</p>
      </section>
      <section>
        <h2>{t('The budget planner and your browser', 'बजट कैलकुलेटर और आपका ब्राउज़र')}</h2>
        <p>{t('The planner adds up the figures you enter on your device. Those amounts stay in the open page and are neither stored by the planner nor sent to the school. If you choose Print, your browser opens its print dialog.', 'कैलकुलेटर आपकी लिखी राशियों का जोड़ आपके डिवाइस पर निकालता है। राशियाँ खुले पेज में ही रहती हैं। कैलकुलेटर उन्हें सहेजता या विद्यालय को भेजता नहीं है। प्रिंट चुनने पर आपके ब्राउज़र की प्रिंट विंडो खुलती है।')}</p>
        <p>{t('Your browser may cache public pages, photographs and other files. Hosting providers may process technical request information to serve and protect this site.', 'आपका ब्राउज़र सार्वजनिक पेज, तस्वीरें और दूसरी फ़ाइलें कैश में रख सकता है। वेबसाइट चलाने और सुरक्षित रखने के लिए होस्टिंग सेवा अनुरोधों से जुड़ी तकनीकी जानकारी संसाधित कर सकती है।')}</p>
        {measurementReady
          ? <p>{t('Advertising measurement is optional for visitors aged 18 or over. You can change your choice at any time.', '18 साल या अधिक उम्र के आगंतुक विज्ञापन मापन चालू करने का विकल्प चुन सकते हैं। अपनी पसंद कभी भी बदल सकते हैं।')} <a href="#measurement">{t('Measurement settings', 'मापन की सेटिंग')}</a></p>
          : <p>{t('Advertising measurement is switched off on this website.', 'इस वेबसाइट पर विज्ञापन मापन बंद है।')}</p>}
      </section>
      <section id="your-choices">
        <h2>{t('Corrections and photograph requests', 'सुधार और तस्वीर से जुड़े अनुरोध')}</h2>
        <p>{t('To ask about an enquiry, correct information or request removal of a photograph or film, call the school office. For an image, give the page address and describe where it appears so staff can find it.', 'अपनी पूछताछ के बारे में जानने, कोई जानकारी सुधरवाने या तस्वीर अथवा फ़िल्म हटाने का अनुरोध करने के लिए कार्यालय में फ़ोन करें। तस्वीर किस पेज पर और कहाँ दिखती है, यह बताएँ ताकि कर्मचारी उसे पहचान सकें।')}</p>
        <a class="inside-link" href={'tel:' + site.phone}>{t('Call the office', 'कार्यालय में फ़ोन करें')} <span dir="ltr">{site.phoneDisplay}</span></a>
      </section>
    </div>
  </div>
)}

{slug === 'news' && (
  <section class="inside-section" id="archive" aria-labelledby="archive-title">
    <div class="wrap">
      <h2 id="archive-title" class="sr-only">{t('Dated school updates', 'तारीख के अनुसार विद्यालय समाचार')}</h2>
      <div class="inside-archive">
        <article>
          <time datetime="2026-11-14">{t('14 November 2026', '14 नवंबर 2026')}</time>
          <div class="inside-archive-feature">
            <div>
              <h3>{t('A classroom moment on Children’s Day', 'बाल दिवस के संदेश में कक्षा की एक झलक')}</h3>
              <p>{t('A pupil stands beside her desk to speak while her classmates listen. The school included this classroom moment in the Children’s Day film it shared on Instagram.', 'एक छात्रा अपनी बेंच के पास खड़ी होकर बोलती है। उसके सहपाठी सुन रहे हैं। विद्यालय ने कक्षा की यह झलक अपनी बाल दिवस फ़िल्म में शामिल की और उसे Instagram पर साझा किया।')}</p>
              <a class="inside-link" href="https://www.instagram.com/reel/DftkPI1lKot/" target="_blank" rel="noopener noreferrer">{t('Watch the school’s film on Instagram', 'Instagram पर विद्यालय की फ़िल्म देखें')}<span aria-hidden="true"><Arrow direction="up-right"/></span></a>
            </div>
            <figure class="inside-figure">
              <Photo id="classroom-participation" lang={lang} phoneMaxWidth={640} sizes="(min-width: 960px) 290px, (min-width: 640px) 42vw, 92vw" />
              <figcaption>{t('From the school’s Children’s Day film, 2026.', 'विद्यालय की बाल दिवस फ़िल्म से, 2026।')}</figcaption>
            </figure>
          </div>
        </article>
        <article>
          <time datetime="2025-02-10">{t('10 February 2025', '10 फ़रवरी 2025')}</time>
          <div class="inside-archive-feature">
            <div>
              <h3>{t('Sports Day at Veer Patta', 'वीर पत्ता का खेल दिवस')}</h3>
              <p>{t('Four young pupils in yellow step out on the chalk lanes at the school sports ground. The day’s programme included relays, sack races and tug of war.', 'विद्यालय के खेल मैदान में पीली टी-शर्ट पहने चार छोटे बच्चे चूने से बनी लेनों में आगे बढ़ते हैं। उस दिन के कार्यक्रम में रिले, बोरी दौड़ और रस्साकशी भी थीं।')}</p>
              <a class="inside-link" href={'/news/2025-01-15-sports-day-' + lang + '/'}>{t('Read the Sports Day report', 'खेल दिवस की रिपोर्ट पढ़ें')}<span aria-hidden="true"><Arrow/></span></a>
            </div>
            <figure class="inside-figure">
              <Photo id="junior-track-games-2025" lang={lang} phoneMaxWidth={640} sizes="(min-width: 960px) 290px, (min-width: 640px) 42vw, 92vw" />
              <figcaption>{t('Early-years track games, 10 February 2025.', 'छोटे बच्चों के ट्रैक खेल, 10 फ़रवरी 2025।')}</figcaption>
            </figure>
          </div>
        </article>
        <article>
          <time datetime="2023">2023</time>
          <div class="inside-archive-feature">
            <div>
              <h3>{t('Pupils welcome visitors to their conference', 'बच्चों ने सम्मेलन में अपने प्रोजेक्ट दिखाए')}</h3>
              <p>{t('Pupils welcomed visitors to a language activity with numbered envelopes and slips of paper. At another display, they presented a food pyramid they had made.', 'बच्चों ने नंबर वाले लिफ़ाफ़ों और कागज़ की पर्चियों से आगंतुकों को भाषा की एक गतिविधि में शामिल किया। दूसरी मेज़ पर विद्यार्थियों ने अपना बनाया भोजन-पिरामिड समझाया।')}</p>
