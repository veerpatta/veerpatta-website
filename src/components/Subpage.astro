  @media(min-width: 700px) { .activity-grid { grid-template-columns: 1fr 1fr; gap: 3.5rem 2.5rem; } .stage-row { grid-template-columns: 220px 1fr; align-items: center; gap: 2.2rem; } .archive-card { grid-template-columns: 180px 1fr; gap: 3rem; } }
  @media(min-width: 1100px) { .stage-row { grid-template-columns: 270px 1fr 90px; gap: 3rem; } .stage-index { display: block; align-self: start; font-size: 3rem; font-weight: 300; color: #64738a; text-align: right; } }
</style>
