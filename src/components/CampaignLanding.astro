---
import {pick,pathFor,site,type Lang} from '../data/site';
import {nativePhonePattern} from '../scripts/enquiry';
import Photo from './Photo.astro';
interface Props {lang:Lang;stage:'pre-primary'|'class-11'}
const {lang,stage}=Astro.props;
const t=(en:string,hi:string)=>pick(lang,en,hi), young=stage==='pre-primary';
const segment=young?t('Nursery & KG','नर्सरी और केजी'):t('Class 11','कक्षा 11');
const points=young?[
 {q:t('Which class fits my child?', 'मेरे बच्चे के लिए कौन-सी कक्षा सही है?'),a:t('Ask the office about entry age, eligibility and class availability before applying.', 'आवेदन से पहले उम्र की शर्त, पात्रता और जगह की जानकारी कार्यालय से लें।')},
 {q:t('What does the school day look like?', 'बच्चे का दिन कैसे बीतेगा?'),a:t('On a visit, see the activity room and ask about the daily routine, drop-off, pickup and what to bring.', 'गतिविधि कक्ष देखें। रोज़ की दिनचर्या, आने-जाने का समय और साथ लाने वाली चीज़ों के बारे में पूछें।')},
 {q:t('What will we need to budget for?', 'फ़ीस के अलावा कौन-से खर्च पूछें?'),a:t('Ask for the current class-wise fees, and check books, uniform and transport separately.', 'संबंधित कक्षा की मौजूदा फ़ीस पूछें। किताबें, वर्दी और परिवहन के खर्च अलग से समझें।')}
]:[
 {q:t('Which streams can we discuss?', 'कौन-से संकायों पर बात कर सकते हैं?'),a:t('Science, Commerce and Arts. Check individual subject combinations and their availability with the office.', 'विज्ञान, वाणिज्य और कला। हर संकाय में कौन-से विषय साथ ले सकते हैं, इसकी पुष्टि कार्यालय से करें।')},
 {q:t('What do I need after Class 10?', 'दसवीं के बाद क्या तैयार रखें?'),a:t('Ask about eligibility and the current document checklist. This website does not ask for marksheets or identity documents.', 'पात्रता और ज़रूरी दस्तावेज़ों की वर्तमान सूची पूछें। इस वेबसाइट पर अंकतालिका या पहचान-पत्र न भेजें।')},
 {q:t('How do we compare options?', 'संकाय चुनने से पहले क्या जानें?'),a:t('Bring the subjects you enjoy to the conversation. Confirm the timetable, fees and subject availability before deciding.', 'अपनी रुचि के विषय लिखकर लाएँ। चुनने से पहले समय-सारणी, फ़ीस और विषयों की उपलब्धता पक्की करें।')}
];
---
<section class:list={['camp-hero',young?'camp-young':'camp-senior']} aria-labelledby="camp-title"><div class="wrap camp-grid">
 <div class="camp-copy"><nav class="camp-crumb" aria-label={t('Breadcrumb','पृष्ठ का मार्ग')}><a href={pathFor(lang,'admissions')}>{t('Admissions','प्रवेश')}</a><span aria-hidden="true">/</span><span>{segment}</span></nav>
  <p class="camp-kicker"><span class="camp-line" aria-hidden="true"></span>{segment} <span aria-hidden="true">·</span> {t('Amet','आमेट')}</p>
  <h1 id="camp-title" class="camp-heading">{young?t('Their first school,','पहला स्कूल,'):t('After Class 10,','दसवीं के बाद,')}<br/><em>{young?t('a closer look.','ज़रा पास से।'):t('which direction?','कौन-सी राह?')}</em></h1>
  <p class="camp-intro">{young?t('See the room, ask about the school day and decide what feels right for your family. Start with a question or a visit to Veer Patta.', 'वीर पट्टा का गतिविधि कक्ष देखें। बच्चे की दिनचर्या, उपयुक्त कक्षा और स्कूल आने के समय पर हमसे बात करें।'):t('Explore Science, Commerce and Arts at Veer Patta. Check subjects, eligibility and fees directly with the school before choosing.', 'वीर पट्टा में विज्ञान, वाणिज्य और कला के विकल्प जानें। विषय, पात्रता और फ़ीस की पुष्टि करके अपनी राह चुनें।')}</p>
  <div class="camp-buttons"><a class="button button-primary" href="#enquiry">{t('Ask about admission','प्रवेश के बारे में पूछें')}<span aria-hidden="true">↓</span></a><a class="camp-call" href={`tel:${site.phone}`}>{t('Call the school','स्कूल में फ़ोन करें')}</a></div>
 </div><figure class="camp-print"><div><Photo id={young?'first-school-room':'science-bench'} lang={lang} eager modern sizes="(min-width:860px) 43vw, 91vw"/></div><figcaption><b aria-hidden="true">{young?'01':'02'}</b><span>{young?t('The activity room at Veer Patta, Amet','वीर पट्टा, आमेट का गतिविधि कक्ष'):t('On the science bench at Veer Patta, Amet','वीर पट्टा, आमेट की विज्ञान प्रयोगशाला की मेज़')}</span></figcaption></figure>
</div></section>
<section class="camp-brief"><div class="wrap camp-brief-grid"><header><p class="camp-kicker">{t('Before you decide','फ़ैसले से पहले')}</p><h2>{young?t('Three questions for a first visit.','पहली मुलाक़ात के तीन सवाल।'):t('Start your subject conversation.','विषय चुनने की तैयारी।')}</h2></header><div class="camp-questions">{points.map((item,i)=><details open={i===0}><summary><span class="camp-q-num" aria-hidden="true">0{i+1}</span>{item.q}<span class="camp-plus" aria-hidden="true">+</span></summary><p>{item.a}</p></details>)}</div></div></section>
<section class="camp-enquiry" id="enquiry" aria-labelledby="enquiry-heading"><div class="wrap camp-contact-grid"><div><p class="camp-kicker">{t('Ask the school office','स्कूल कार्यालय से संपर्क')}</p><h2 id="enquiry-heading">{t('Tell us how to reach you.','आपसे कैसे संपर्क करें?')}</h2><p>{t('Only an adult’s contact details are needed. Do not send a child’s name, marksheet or ID. An enquiry is not a seat reservation or an appointment.', 'सिर्फ़ अभिभावक की जानकारी दें। बच्चे का नाम, अंकतालिका या पहचान-पत्र न भेजें। पूछताछ से सीट या मुलाक़ात का समय बुक नहीं होता।')}</p><p class="camp-office">{t('Prefer a conversation?', 'फ़ोन पर बात करना चाहेंगे?')}<a href={`tel:${site.phone}`}>{site.phoneDisplay}</a></p></div>
 <form class="camp-form" action="https://formspree.io/f/xgveybpz" method="POST" data-campaign-form data-lang={lang}>
  <fieldset><legend>{segment} · {t('Enquiry','पूछताछ')}</legend><input type="hidden" name="source" value={`school-website-${stage}-${lang}`} />
  <div class="field"><label for="camp-parent">{t('Parent or guardian’s name','अभिभावक का नाम')}</label><input id="camp-parent" name="guardian" autocomplete="name" minlength="2" maxlength="80" required/></div>
  <div class="field"><label for="camp-phone">{t('Parent’s mobile number','अभिभावक का मोबाइल नंबर')}</label><input type="tel" id="camp-phone" name="phone" autocomplete="tel" inputmode="tel" pattern={nativePhonePattern} maxlength="20" title={t('10-digit Indian mobile number, with or without +91','10 अंकों का भारतीय मोबाइल नंबर, +91 के साथ या बिना')} required /></div>
  {young?<div class="field"><label for="camp-class">{t('Class you want to ask about','किस कक्षा के बारे में पूछना है?')}</label><select id="camp-class" name="class" required><option value="">{t('Choose a class','कक्षा चुनें')}</option><option value="Nursery">{t('Nursery','नर्सरी')}</option><option value="KG">{t('KG','केजी')}</option><option value="Pre-primary guidance">{t('Help me choose','कक्षा चुनने में मदद चाहिए')}</option></select></div>:<input type="hidden" name="class" value="Class 11"/>}
  <label class="consent"><input type="checkbox" name="consent" value="School enquiry via Formspree" required/><span>{t('I agree to send these details to the school through Formspree so the office can respond.', 'कार्यालय के जवाब के लिए मैं ये जानकारी Formspree के माध्यम से स्कूल को भेजने के लिए सहमत हूँ।')} <a href={pathFor(lang,'privacy')}>{t('Privacy','गोपनीयता')}</a></span></label>
  <button type="submit" class="button button-primary">{t('Send my enquiry','मेरी पूछताछ भेजें')} <span aria-hidden="true">→</span></button></fieldset><p class="camp-status" data-campaign-status role="status" tabindex="-1"></p>
  <noscript><p>{t('Submitting opens Formspree to show the result.', 'भेजने पर परिणाम देखने के लिए Formspree खुलेगा।')}</p></noscript>
 </form></div></section>
<nav class="camp-exit" aria-label={t('More admissions options','प्रवेश के अन्य विकल्प')}><div class="wrap"><a href={pathFor(lang,'admissions')}>{t('All classes and fee planner','सभी कक्षाएँ और खर्च का अनुमान')}</a><a href={pathFor(lang,'contact')+'#visit'}>{t('Directions and visit guide','रास्ता और स्कूल आने की जानकारी')}</a><a href={pathFor(lang,young?'admissions/class-11':'admissions/pre-primary')}>{young?t('Looking for Class 11?','कक्षा 11 की जानकारी चाहिए?'):t('Looking for Nursery or KG?','नर्सरी या केजी की जानकारी चाहिए?')}</a></div></nav>
<script>import '../scripts/campaign-form';</script>
