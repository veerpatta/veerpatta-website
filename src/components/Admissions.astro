---
import Arrow from './Arrow.astro';
import { pathFor, pick, site, type Lang } from '../data/site';
import { schoolFaqs } from '../data/content';
import AdmissionsHub from './AdmissionsHub.astro';
import Photo from './Photo.astro';
import WhatsAppEnquiry from './WhatsAppEnquiry.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = (en: string, hi: string) => pick(lang, en, hi);
const fields = [
  { name: 'tuition', label: t('Tuition for the year', 'पूरे वर्ष की स्कूल फ़ीस') },
  { name: 'admission', label: t('One-time admission fee', 'एक बार का प्रवेश शुल्क') },
  { name: 'books', label: t('Books for the year', 'पूरे वर्ष की किताबें') },
  { name: 'uniform', label: t('Uniform for the year', 'पूरे वर्ष की वर्दी') },
  { name: 'transport', label: t('Transport for the year', 'पूरे वर्ष का परिवहन') },
];
---

<AdmissionsHub lang={lang} />
<section class="admissions-block admissions-tint" id="enquiry" aria-labelledby="enquiry-heading">
  <WhatsAppEnquiry lang={lang} />
</section>

<section class="admissions-block" id="budget" aria-labelledby="budget-heading">
  <div class="wrap budget-layout">
    <div>
      <h2 id="budget-heading">{t('Plan your school budget', 'स्कूल के खर्च का अनुमान लगाएँ')}</h2>
      <p>{t('Use the written fee details from the office to estimate your annual and first-year costs. For recurring costs, enter the full-year amount in rupees.', 'कार्यालय से मिले लिखित शुल्क विवरण के आधार पर सालाना और पहले वर्ष का खर्च जोड़ें। नियमित खर्चों के लिए पूरे वर्ष की राशि रुपये में लिखें।')}</p>
      <p>{t('You can leave any amount blank. It counts as zero in your estimate. The calculation stays on this device.', 'आप किसी भी राशि को खाली छोड़ सकते हैं। अनुमान में वह रक़म शून्य मानी जाएगी। हिसाब इसी डिवाइस पर होता है।')}</p>
      <a class="text-link budget-call" href={`tel:${site.phone}`}>{t('Call for current fee details', 'मौजूदा शुल्क विवरण के लिए फ़ोन करें')} <span aria-hidden="true"><Arrow/></span></a>
    </div>
    <form class="budget-card" data-budget-form data-lang={lang} aria-labelledby="budget-heading">
      <div class="form-grid">
        {fields.map(field => (
          <div class="field">
            <label for={`budget-${field.name}`}>{field.label}</label>
            <div class="money-input">
              <span aria-hidden="true">₹</span>
              <input id={`budget-${field.name}`} type="text" inputmode="decimal" name={field.name}
                placeholder={t('Optional', 'वैकल्पिक')} autocomplete="off" maxlength="16" />
            </div>
          </div>
        ))}
      </div>
      <button type="button" class="button calculate" data-budget-calculate hidden>
        {t('Calculate my estimate', 'मेरा अनुमान निकालें')} <span aria-hidden="true"><Arrow/></span>
      </button>
      <p data-budget-error role="alert" class="budget-error"></p>
      <div class="budget-result" data-budget-result tabindex="-1" aria-live="polite" hidden>
        <div><span>{t('Annual costs entered', 'लिखे गए सालाना खर्च')}</span><strong data-budget-annual></strong></div>
        <div><span>{t('First year with the admission fee', 'प्रवेश शुल्क सहित पहला वर्ष')}</span><strong data-budget-first></strong></div>
        <p>{t('Confirm the final amount and payment terms with the office.', 'अंतिम राशि और भुगतान की शर्तें कार्यालय से पक्की करें।')}</p>
      </div>
      <button type="button" class="text-link budget-print" data-budget-print hidden>{t('Print this estimate', 'यह अनुमान प्रिंट करें')}</button>
      <noscript><p>{t('The calculator needs JavaScript. Call the office for a written fee quote.', 'कैलकुलेटर के लिए JavaScript चाहिए। लिखित शुल्क विवरण के लिए कार्यालय को फ़ोन करें।')}</p></noscript>
    </form>
  </div>
</section>

<section class="admissions-block admissions-tint" aria-labelledby="visit-heading">
  <div class="wrap budget-layout admissions-visit">
    <div class="visit-photo"><Photo id="campus-front" lang={lang} sizes="(min-width: 850px) 36vw, 94vw" /></div>
    <div>
      <h2 id="visit-heading">{t('Visit the school in Amet', 'आमेट में स्कूल देखने आएँ')}</h2>
      <p>{t('The school is opposite Mela Ground. Call the office to agree on a time, then bring your questions about the classrooms, school day or the subjects your child enjoys.', 'स्कूल मेला ग्राउंड के सामने है। कार्यालय से फ़ोन पर समय तय करें। कक्षाओं, दिनचर्या या अपने बच्चे के पसंदीदा विषयों के बारे में आप यहाँ बात कर सकते हैं।')}</p>
      <a href={pathFor(lang, 'contact') + '#visit'} class="text-link budget-call">{t('Directions and visit information', 'रास्ता और मुलाक़ात की जानकारी')} <span aria-hidden="true"><Arrow/></span></a>
    </div>
  </div>
</section>

<section class="admissions-block" aria-labelledby="questions-heading">
  <div class="wrap budget-layout">
    <div>
      <h2 id="questions-heading">{t('Admission questions', 'प्रवेश से जुड़े सवाल')}</h2>
      <a class="text-link budget-call" href={pathFor(lang, 'faq')}>{t('All questions for the school', 'स्कूल से जुड़े सभी सवाल')} <span aria-hidden="true"><Arrow/></span></a>
    </div>
    <div class="faq-list">{schoolFaqs.filter(faq => faq.group === 'admissions-and-fees').map(faq => <details><summary>{faq.q[lang]}</summary><p>{faq.a[lang]}</p></details>)}</div>
  </div>
</section>

<script>import '../scripts/admissions';</script>
<style>
  .admissions-block { padding-block: clamp(2.5rem, 5.8vw, 5.5rem); }
  .admissions-tint { background: var(--cream, #f3ecdf); }
  .budget-layout { display: grid; align-items: start; gap: 1.65rem 5vw; }
  .budget-layout h2 { max-width: 16ch; }
  .budget-layout h2 + p, .budget-layout p + p { margin-top: .85rem; }
  .budget-layout > div > p { max-width: 46ch; }
  .budget-call, .budget-print { min-height: 44px; font-weight: 700; text-decoration: underline; text-underline-offset: .19em; }
  .budget-call { margin-top: .65rem; color: var(--blue); }
  .budget-card { border: 1px solid var(--line, #d8cec0); border-top: 3px solid var(--ink, #172e40); border-radius: .35rem; padding: clamp(1.1rem, 3vw, 2.25rem); min-width: 0; background: var(--paper, #fffcf5); }
  .budget-card label { font-weight: 650; }
  .budget-card input { min-height: 44px; border-radius: .25rem; border-color: #a39786; background: #fff; }
  .money-input { position: relative; }
  .money-input span { position: absolute; top: 50%; left: .85rem; transform: translateY(-50%); color: var(--ink, #172e40); }
  .money-input input { padding-left: 2rem; }
  .budget-card .form-grid { margin-bottom: 1.25rem; }
  .calculate { background: var(--blue); color: white; }
  .calculate:hover { background: var(--navy-deep); }
  .budget-result { margin: 1.25rem 0 .4rem; padding: 1rem; border-inline-start: 3px solid var(--blue); background: var(--cream, #f3ecdf); }
  .budget-result > div { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: .25rem .7rem; padding: .35rem 0; }
  .budget-result strong { font-size: 1.28rem; }
  .budget-result p, .budget-error { font-size: .91rem; }
  .budget-error { color: #9b2427; }
  .budget-error:not(:empty) { margin-top: .75rem; }
  .admissions-visit { align-items: center; }
  .visit-photo { overflow: hidden; aspect-ratio: 1.95; border-radius: .25rem; }
  .visit-photo :global(img) { width: 100%; height: 100%; object-fit: cover; }
  [hidden] { display: none !important; }
  @media (min-width: 850px) { .budget-layout { grid-template-columns: minmax(0, .85fr) minmax(0, 1.4fr); } }
  @media print { .budget-card { break-inside: avoid; } [data-budget-calculate], [data-budget-print] { display: none !important; } }
</style>
