---
import Photo from './Photo.astro';
import {pick,pathFor,type Lang} from '../data/site';
interface Props { lang:Lang }
const {lang}=Astro.props;
const t=(en:string,hi:string)=>pick(lang,en,hi);
---
<section class="school-cover" aria-labelledby="cover-title"><div class="cover-inside">
 <div class="cover-copy"><div class="cover-overline"><span class="cover-sun" aria-hidden="true"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 2v20M2 12h20M5 5l14 14M5 19 19 5"/></svg></span>{t('A school in Amet, Rajasthan','आमेट, राजस्थान का अपना स्कूल')}</div>
 <h1 id="cover-title">{t('Come inside.','आइए, स्कूल को')}<br/><em>{t('See school life.','अंदर से देखें।')}</em></h1>
 <p>{t('Walk through Veer Patta, find your child’s class and ask about a school visit. Start with the things you’d like to see for yourself.', 'वीर पट्टा की कक्षाएँ और परिसर देखें। अपने बच्चे की कक्षा चुनें और स्कूल आने का समय पूछें।')}</p>
 <div class="cover-buttons"><a class="cover-main" href={pathFor(lang,'admissions')}>{t('Explore admissions','प्रवेश की जानकारी')}<svg width="19" height="19" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 10h14m-6-6 6 6-6 6"/></svg></a><a class="cover-film" href="#school-film"><span aria-hidden="true"><svg width="11" height="11" viewBox="0 0 12 12" fill="currentColor"><path d="M3 1.2 11 6 3 10.8z"/></svg></span>{t('School film','स्कूल की फ़िल्म')}</a></div>
 <div class="cover-folio" aria-hidden="true"><span>VPPS</span><i></i><span>AMET • RAJASTHAN</span></div></div>
 <figure class="cover-scene"><Photo id="dance-lawn" lang={lang} modern eager sizes="(min-width: 860px) 51vw, 100vw"/><figcaption><span class="cover-photo-num" aria-hidden="true">01</span><span>{t('On campus','हमारे परिसर से')}<b>{t('A dance on the school lawn','स्कूल के लॉन पर समूह नृत्य')}</b></span><a href={pathFor(lang,'gallery')} aria-label={t('Explore more school photographs','स्कूल की और तस्वीरें देखें')}><svg width="23" height="23" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 16 16 4m0 0H6m10 0v10"/></svg></a></figcaption></figure>
</div></section>
