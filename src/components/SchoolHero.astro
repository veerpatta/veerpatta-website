---
import Photo from './Photo.astro';
import {pick,pathFor,type Lang} from '../data/site';
interface Props {lang:Lang}
const {lang}=Astro.props,t=(en:string,hi:string)=>pick(lang,en,hi);
---
<section class="amet-cover" aria-labelledby="cover-title"><div class="amet-spread">
 <div class="amet-intro"><p class="amet-place">{t('Amet, Rajasthan · RBSE','आमेट, राजस्थान · आरबीएसई')}</p>
 <h1 id="cover-title">{t('A school day at','एक दिन')} <em>{t('Veer Patta.','वीर पट्टा में।')}</em></h1>
 <p class="amet-deck">{t('From first words in primary school to choosing a Class 11 stream. See what happens in the classroom and out on our lawn opposite Mela Ground.','प्राथमिक में पहला शब्द पढ़ने से लेकर कक्षा 11 में संकाय चुनने तक। मेला ग्राउंड के सामने हमारे विद्यालय की कक्षाओं और मैदान की झलक देखें।')}</p>
 <div class="amet-actions"><a class="button cover-main" href={pathFor(lang,'admissions')+'#choose-class'}>{t('Find your class','अपनी कक्षा चुनें')} <span aria-hidden="true">→</span></a>
 <a class="cover-film" href="#school-film"><span aria-hidden="true">▷</span>{t('School film','स्कूल की फ़िल्म')}</a></div></div>
 <figure class="amet-figure"><Photo id="amet-lawn-phone" lang={lang} eager sizes="100vw" art={{id:'amet-lawn',media:'(min-width: 760px)',sizes:'(min-width:1440px) 800px, 55vw'}}/>
 <figcaption><span>{t('On the school lawn, Amet','विद्यालय का मैदान, आमेट')}</span><a href={pathFor(lang,'beyond')}>{t('School life','स्कूल जीवन')} <span aria-hidden="true">↗</span></a></figcaption></figure>
</div></section>
<style>
.amet-cover{color:#152e35;background:#f8f2e4;border-bottom:1px solid #c2c7bc}.amet-spread{display:grid;max-width:1480px;margin:auto}.amet-intro{padding:clamp(19px,4vw,58px) max(18px,calc((100vw - 1300px)/2));min-width:0}
.amet-place{display:flex;align-items:center;gap:.75rem;font-size:.78rem;font-weight:750;letter-spacing:.055em;color:#375249}.amet-place:before{content:'';width:2rem;height:3px;background:#b17720}
.amet-intro h1{font-family:Georgia,'Noto Serif Devanagari',serif;font-size:clamp(2.5rem,7.9vw,6.6rem);font-weight:500;line-height:1.01;letter-spacing:-.05em;margin:.65rem 0}
.amet-intro h1 em{color:#255c4d;white-space:nowrap;font-weight:500}.amet-deck{max-width:43ch;font-size:clamp(.96rem,1.45vw,1.13rem);line-height:1.55;color:#334a48}
.amet-actions{display:flex;align-items:center;gap:1.15rem;flex-wrap:wrap;margin-top:1.1rem}.amet-actions .cover-main{background:#164a43;color:white;border-radius:4px}.amet-actions .cover-film{display:inline-flex;align-items:center;gap:.45rem;color:#1d3938;font-weight:700;min-height:44px}.amet-actions .cover-film span{color:#1d3938;border:1px solid #9da998}
.amet-figure{position:relative;min-width:0;margin:0;align-self:stretch;background:#e2ddc7;display:flex;flex-direction:column}.amet-figure :global(picture){flex:1;aspect-ratio:1.75;height:auto}.amet-figure :global(img){height:100%;width:100%;object-fit:cover}.amet-figure figcaption{padding:.6rem max(18px,3vw);display:flex;gap:.7rem;align-items:center;justify-content:space-between;background:#173e37;color:white;font-size:.81rem}.amet-figure a{color:#fff4d4;text-decoration:underline;text-underline-offset:3px}
:global(html[lang=hi]) .amet-intro h1{line-height:1.25;letter-spacing:-.025em}:global(html[lang=hi]) .amet-intro h1 em{font-style:normal}
@media(min-width:760px){.amet-spread{grid-template-columns:.9fr 1.1fr}.amet-intro{align-self:center;padding:clamp(35px,5.1vw,80px)}.amet-intro h1 em{display:block}.amet-figure :global(picture){position:relative;aspect-ratio:auto;min-height:300px}.amet-figure :global(img){position:absolute;inset:0}.amet-figure figcaption{padding:.75rem 1.25rem}}
</style>
