---
import Arrow from './Arrow.astro';
import { schoolHouses } from '../data/content';
import { pathFor, pick, type Lang } from '../data/site';
import Photo from './Photo.astro';
import VideoCard from './VideoCard.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = (en: string, hi: string) => pick(lang, en, hi);
---
<section class="inside-section" id="houses" aria-labelledby="houses-title">
  <div class="wrap">
    <div class="inside-section-head inside-section-head--intro">
      <h2 id="houses-title">{t('Four houses, four colours', 'चार सदन, चार रंग')}</h2>
      <p>{t('The houses carry names from Mewar’s history. Each has a colour of its own. At the inter-house dance competition, pupils perform together on the school lawn.', 'विद्यालय के सदनों के नाम मेवाड़ के इतिहास से लिए गए हैं। हर सदन का अपना एक रंग है। अंतर-सदनीय नृत्य प्रतियोगिता में बच्चे विद्यालय के लॉन पर समूह में प्रस्तुति देते हैं।')}</p>
    </div>
    <ul class="inside-houses">
      {schoolHouses.map(house => (
        <li data-house-colour={house.key}>
          <span class="inside-house-stripe" aria-hidden="true"></span>
          <strong>{house.name[lang]}</strong>
          <span>{house.colour[lang]}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<section id="school-activities" class="inside-section inside-soft" aria-labelledby="activities-title">
  <div class="wrap">
    <div class="inside-section-head"><h2 id="activities-title">{t('Sports and performance', 'खेल और प्रस्तुतियाँ')}</h2></div>
    <div class="inside-life-pair">
      <article class="inside-life-entry">
        <Photo id="race-lanes" lang={lang} sizes="(min-width: 770px) 43vw, 94vw" />
        <h3>{t('Sports Day on the grounds', 'मैदान पर खेल दिवस')}</h3>
        <p>{t('On 10 February 2025, the school held Sports Day at the Veer Patta Sports Ground. The programme included individual sprints, relay races and tug of war.', '10 फ़रवरी 2025 को वीर पत्ता खेल मैदान में विद्यालय का खेल दिवस हुआ। कार्यक्रम में छोटी दूरी की दौड़, रिले और रस्साकशी शामिल थीं।')}</p>
        <a class="inside-link" href={pathFor(lang, 'gallery') + '?category=sports#photos'}>
          {t('Sports photographs', 'खेल की तस्वीरें')}<span aria-hidden="true"><Arrow/></span>
        </a>
      </article>
      <article class="inside-life-entry">
        <VideoCard id="lawn-dance-detail" lang={lang} />
        <h3>{t('Inter-house dance', 'अंतर-सदनीय नृत्य')}</h3>
        <p>{t('At the inter-house dance competition, the school lawn becomes a stage. Groups perform together outdoors, with the main building as their backdrop.', 'अंतर-सदनीय नृत्य प्रतियोगिता के दिन विद्यालय का लॉन ही मंच बन जाता है। मुख्य भवन के सामने खुले मैदान में बच्चे अपने समूह के साथ प्रस्तुति देते हैं।')}</p>
        <a class="inside-link" href={pathFor(lang, 'gallery') + '?category=cultural#photos'}>
          {t('Dance and performance photographs', 'नृत्य और प्रस्तुतियों की तस्वीरें')}<span aria-hidden="true"><Arrow/></span>
        </a>
      </article>
    </div>
  </div>
</section>

<section id="ncc" class="inside-section" aria-labelledby="ncc-title">
  <div class="wrap inside-split inside-ncc">
    <div class="inside-copy">
      <p class="inside-label">{t('NCC', 'एनसीसी')}</p>
      <h2 id="ncc-title">{t('National Cadet Corps', 'राष्ट्रीय कैडेट कोर')}</h2>
      <p>{t('The school archive includes NCC cadets in parade uniform. If your child is interested in NCC, ask the office whether enrolment is available this session, which classes can apply and what activities are planned.', 'विद्यालय के संग्रह में परेड की वर्दी पहने एनसीसी कैडेटों की तस्वीरें हैं। यदि आपके बच्चे की एनसीसी में रुचि है, तो कार्यालय से पूछें कि इस सत्र में नामांकन खुला है या नहीं, किन कक्षाओं के बच्चे आवेदन कर सकते हैं और कौन-सी गतिविधियाँ तय हैं।')}</p>
      <a class="inside-link" href={pathFor(lang, 'contact')}>{t('Ask the school office', 'विद्यालय कार्यालय से पूछें')}<span aria-hidden="true"><Arrow/></span></a>
    </div>
    <figure class="inside-figure">
      <Photo id="ncc-sashes" lang={lang} sizes="(min-width: 1260px) 580px, (min-width: 770px) 46vw, 94vw" />
      <figcaption>{t('Striped belts and sashes on the school cadets’ uniforms.', 'विद्यालय के कैडेटों की वर्दी पर धारीदार बेल्ट और कमरबंद।')}</figcaption>
    </figure>
  </div>
</section>
