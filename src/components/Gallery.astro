---
import PageHead from './PageHead.astro';
import Photo from './Photo.astro';
import VideoCard from './VideoCard.astro';
import {photos,galleryIds} from '../data/media';
import {pick,type Lang} from '../data/site';
interface Props {lang:Lang}
const {lang}=Astro.props;
const categories=[['all',pick(lang,'All moments','सभी पल')],['campus',pick(lang,'Our campus','हमारा परिसर')],['academic',pick(lang,'Learning','शिक्षा')],['sports',pick(lang,'Sports','खेल')],['cultural',pick(lang,'Culture','संस्कृति')],['ncc','NCC'],['celebrations',pick(lang,'Celebrations','उत्सव')]];
const items=galleryIds.filter(id=>photos[id]?.gallery);
---
<PageHead lang={lang} kicker={pick(lang,'Photos & films','तस्वीरें और फ़िल्में')} title={pick(lang,'A little window into our world.','हमारी दुनिया की एक छोटी खिड़की।')} description={pick(lang,'Real places. Real school days. Explore our campus, learning spaces and moments we share together.','असली जगहें। असली स्कूल के दिन। परिसर, कक्षाएँ और साथ बिताए हुए पल देखें।')} />
<section class="section gallery-section"><div class="wrap"><div class="gallery-toolbar"><div class="filter-list" role="group" aria-label={pick(lang,'Filter photographs','तस्वीरें चुनें')}>{categories.map(([key,label])=><button type="button" data-gallery-filter={key} aria-pressed={key==='all'}>{label}</button>)}</div><p class="gallery-count" data-gallery-count aria-live="polite">{items.length} {pick(lang,'photographs','तस्वीरें')}</p></div><div class="gallery-grid">{items.map(id=>{const p=photos[id];return <figure data-gallery-category={p.gallery} class="gallery-item"><a href={`/assets/media/photos/${id}-${p.widths[p.widths.length-1]}.webp`} data-photo-open data-photo-caption={p.alt[lang]}><Photo id={id} lang={lang} sizes="(min-width: 1000px) 31vw, (min-width: 650px) 46vw, 94vw"/><span class="photo-expand" aria-hidden="true">↗</span></a><figcaption>{p.alt[lang]}</figcaption></figure>})}</div><p class="note gallery-note">{pick(lang,'These are authentic school photographs. Open any image for a closer look. No AI illustrations are presented as school photographs.','ये स्कूल की असली तस्वीरें हैं। बड़ा देखने के लिए किसी भी तस्वीर को खोलें। एआई चित्रों को स्कूल की असली तस्वीरों की तरह प्रस्तुत नहीं किया गया है।')}</p></div></section>
<section class="section section-navy" id="videos"><div class="wrap"><div class="section-head"><div><p class="eyebrow">{pick(lang,'Press play','चलाकर देखें')}</p><h2>{pick(lang,'School life,','स्कूल जीवन,')}<br/><em>{pick(lang,'in motion.','चलती तस्वीरों में।')}</em></h2></div><p class="section-intro">{pick(lang,'Videos load only when you choose to watch. Clip lengths and file sizes are shown so you can decide when to use your mobile data.','वीडियो तभी लोड होंगे जब आप देखना चाहें। समय और फ़ाइल का आकार साथ दिया है, ताकि आप मोबाइल डेटा का ध्यान रख सकें।')}</p></div><div class="video-grid">{['school-story','campus-tour','sports-day','house-dance','cultural-stage'].map(id=><VideoCard id={id} lang={lang}/>)}</div><p class="note">{pick(lang,'“A little glimpse of our world” is a 24-second silent edited montage of real school photographs. “Campus film” also combines photographs and short clips; other cards show event clips. Event clips play muted by default.','“हमारी दुनिया की एक छोटी झलक” असली तस्वीरों की 24 सेकंड की बिना आवाज़ वाली संपादित फ़िल्म है। “कैंपस फ़िल्म” में भी तस्वीरें और छोटे क्लिप हैं; बाकी कार्यक्रमों के क्लिप हैं। कार्यक्रमों के वीडियो शुरुआत में बिना आवाज़ चलते हैं।')}</p></div></section>
