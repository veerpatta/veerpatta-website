---
import Arrow from './Arrow.astro';
import PageHead from './PageHead.astro';
import Photo from './Photo.astro';
import VideoCard from './VideoCard.astro';
import { photos, galleryIds, videos } from '../data/media';
import { galleryCategories, type GalleryCategory } from '../scripts/gallery';
import { pick, pathFor, type Lang } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = (en: string, hi: string) => pick(lang, en, hi);
const labels: Record<GalleryCategory, string> = {
  all: t('All photos', 'सभी तस्वीरें'),
  campus: t('Campus', 'परिसर'),
  academic: t('Learning', 'पढ़ाई'),
  sports: t('Sport', 'खेल'),
  cultural: t('Arts & stage', 'कला और मंच'),
  ncc: t('NCC', 'एनसीसी'),
};
---
<PageHead lang={lang}
  kicker={t('School album', 'विद्यालय का एल्बम')}
  title={t('The school in photographs', 'तस्वीरों में हमारा विद्यालय')}
  description={t('Walk through the campus, take a seat at the exhibition table and step onto the playing field.', 'परिसर की सैर करें, प्रदर्शनी की मेज़ पर रखे मॉडल देखें और खेल के मैदान की झलक पाएँ।')}
  image="assembly-courtyard" caption={t('The paved assembly courtyard under its blue canopy.', 'नीली छत के नीचे विद्यालय का प्रार्थना प्रांगण।')}
  links={[{ href: '#photos', label: t('Browse photographs', 'तस्वीरें देखें') }, { href: '#videos', label: t('Watch the short films', 'छोटी फ़िल्में देखें') }]} />

<section class="album-section" id="photos" aria-labelledby="album-photos">
  <div class="wrap">
    <header class="album-section-head">
      <div>
        <h2 id="album-photos">{t('Browse the album', 'एल्बम देखें')}</h2>
        <p>{t('Choose a subject or open a photograph to see the full frame.', 'विषय चुनें या पूरी तस्वीर देखने के लिए उसे खोलें।')}</p>
      </div>
      <p class="album-count" data-gallery-count aria-live="polite" aria-atomic="true">{galleryIds.length} {t('photographs', 'तस्वीरें')}</p>
    </header>
    <div class="album-filters" data-enhanced-gallery hidden role="group" aria-label={t('Filter photographs by subject', 'विषय के अनुसार तस्वीरें चुनें')}>
      {galleryCategories.map(category => <button type="button" data-gallery-filter={category} aria-pressed={category === 'all'}>{labels[category]}</button>)}
    </div>
    <div class="album-grid">
      {galleryIds.map(id => {
        const photo = photos[id];
        return <figure class="album-print" data-gallery-category={photo.gallery}>
          <a href={`/assets/media/photos/${id}-${photo.w}.webp`} data-photo-open data-photo-caption={photo.alt[lang]}>
            <Photo id={id} lang={lang} sizes="(min-width: 1400px) 400px, (min-width: 980px) 30vw, (min-width: 580px) 45vw, 92vw"/>
            <span class="album-enlarge" aria-hidden="true">
              <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 2h5v5M14 2 8.5 7.5M7 14H2V9m0 5 5.5-5.5"/></svg>
            </span>
          </a>
          <figcaption>{photo.alt[lang]}</figcaption>
        </figure>;
      })}
    </div>
  </div>
</section>

<section class="album-section album-films" id="videos" aria-labelledby="album-films">
  <div class="wrap">
    <header class="album-section-head">
      <div>
        <h2 id="album-films">{t('Short films', 'छोटी फ़िल्में')}</h2>
        <p>{t('Choose a film to load it. Both are silent and have scene descriptions in English and Hindi.', 'जिस फ़िल्म को देखना हो, उसे चलाएँ। दोनों फ़िल्में बिना आवाज़ की हैं और दृश्यों का विवरण हिंदी और अंग्रेज़ी में दिया है।')}</p>
      </div>
    </header>
    <div class="album-film-grid">{Object.keys(videos).map(id => <VideoCard id={id} lang={lang} />)}</div>
  </div>
</section>

<section class="album-visit" aria-labelledby="album-visit">
  <div class="wrap album-visit-inner">
    <div><h2 id="album-visit">{t('Visit the campus', 'परिसर देखने आएँ')}</h2>
      <p>{t('Call the office to arrange a time to see the classrooms and grounds in Amet.', 'आमेट में कक्षाएँ और मैदान देखने के लिए कार्यालय से समय तय करें।')}</p></div>
    <a class="button button-primary" href={pathFor(lang, 'contact') + '#visit'}>{t('Plan a visit', 'मुलाक़ात का समय तय करें')} <span aria-hidden="true"><Arrow/></span></a>
  </div>
</section>
<style>
  .album-section { padding-block:clamp(2.5rem,5.8vw,5.2rem); }
  .album-section-head, .album-visit-inner { display:flex; flex-wrap:wrap; align-items:end; justify-content:space-between; gap:1rem 2rem; }
  .album-section-head h2, .album-visit h2 { color:var(--ink); font-family:var(--serif); font-size:clamp(2rem,4.3vw,3.6rem); line-height:1.15; margin:0; }
  .album-section-head p, .album-visit p { color:var(--muted); max-width:58ch; margin:.55rem 0 0; }
  .album-section-head .album-count { color:var(--maroon,#762f39); font-size:.83rem; font-weight:700; }
  .album-filters { display:flex; flex-wrap:wrap; gap:.35rem .55rem; margin-top:1.1rem; }
  .album-filters button { border:1px solid #bdb2a3; font:inherit; font-weight:600; font-size:.86rem; color:var(--ink); background:transparent; min-height:44px; padding:.35rem .85rem; border-radius:2rem; }
  .album-filters button[aria-pressed=true] { border-color:var(--maroon,#762f39); color:white; background:var(--maroon,#762f39); }
  .album-filters button:hover:not([aria-pressed=true]) { background:var(--cream); }
  .album-grid { display:grid; gap:1.7rem clamp(1rem,2.5vw,2.25rem); margin-top:1.4rem; padding-top:1.45rem; border-top:1px solid var(--line); }
  .album-print { margin:0; min-width:0; }
  .album-print a { position:relative; display:block; background:var(--cream); }
  .album-print :global(picture) { display:block; }
  .album-print :global(img) { width:100%; height:auto; aspect-ratio:1.55; object-fit:cover; display:block; }
  .album-enlarge { position:absolute; right:.5rem; bottom:.5rem; padding:.4rem; display:grid; place-items:center; color:white; background:#172e40d9; border-radius:50%; }
  .album-print figcaption { font-size:.88rem; line-height:1.5; color:var(--ink); margin-top:.55rem; }
  .album-films { background:var(--cream); }
  .album-film-grid { display:grid; gap:2rem; margin-top:1.7rem; }
  .album-visit { padding-block:clamp(2.4rem,5.5vw,4.6rem); background:var(--paper); }
  .album-visit .button { align-self:center; }
  :global(html[lang=hi]) .album-section-head h2, :global(html[lang=hi]) .album-visit h2 { line-height:1.35; }
  @media (min-width:580px) { .album-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
  @media (min-width:760px) { .album-film-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
  @media (min-width:980px) { .album-grid { grid-template-columns:repeat(3,minmax(0,1fr)); } }
</style>
