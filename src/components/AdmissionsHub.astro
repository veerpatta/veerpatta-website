---
import {pick,pathFor,type Lang} from '../data/site';
import Photo from './Photo.astro';
interface Props{lang:Lang} const {lang}=Astro.props,t=(en:string,hi:string)=>pick(lang,en,hi);
const tracks=[{slug:'pre-primary',photo:'early-years-track',label:t('First school','पहला स्कूल'),name:t('Nursery & KG','नर्सरी और केजी')},{slug:'class-11',photo:'circulatory-model',label:t('After Class 10','दसवीं के बाद'),name:t('Class 11','कक्षा 11')}];
---
<section class="ad-hub"><div class="wrap"><p class="camp-kicker"><span class="camp-line" aria-hidden="true"></span>{t('Admissions · Amet','प्रवेश · आमेट')}</p><h1>{t('Which class are you looking for?','किस कक्षा की जानकारी चाहिए?')}</h1><p class="ad-hub-intro">{t('Start with a class guide, or contact the school about any class from Nursery through Class 12.', 'अपनी कक्षा की जानकारी से शुरू करें। नर्सरी से कक्षा 12 तक किसी भी कक्षा के बारे में कार्यालय से पूछ सकते हैं।')}</p><div class="hub-links">{tracks.map(x=><a class="hub-link" href={pathFor(lang,'admissions/'+x.slug)}><Photo id={x.photo} lang={lang} sizes="110px"/><span><small>{x.label}</small><strong>{x.name}</strong></span><span class="hub-arrow" aria-hidden="true">→</span></a>)}</div><div class="hub-misc"><a href="#enquiry">{t('Ask on WhatsApp about any class','किसी भी कक्षा के बारे में WhatsApp पर पूछें')}</a><a href="#budget">{t('Plan your school budget','खर्च का अपना अनुमान बनाएँ')}</a><a href={pathFor(lang,'contact')+'#visit'}>{t('Plan a visit','आने का समय पूछें')}</a></div></div></section>
