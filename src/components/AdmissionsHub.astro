---
import {pick,pathFor,type Lang} from '../data/site';
import ClassChooser from './ClassChooser.astro';
interface Props {lang:Lang}
const {lang}=Astro.props,t=(en:string,hi:string)=>pick(lang,en,hi);
---
<section class="intake-cover"><div class="wrap intake-grid"><div>
 <p class="eyebrow">{t('Admissions · Amet','प्रवेश · आमेट')}</p><h1>{t('Which class are you looking for?','किस कक्षा की जानकारी चाहिए?')}</h1>
 <p>{t('Start with your child’s class. The school office can confirm current availability, subject choices and a time to visit.','अपने बच्चे की कक्षा से शुरुआत करें। मौजूदा सीटों, विषयों और मुलाक़ात के समय की पुष्टि कार्यालय से करें।')}</p>
 <nav aria-label={t('Admission guides','प्रवेश की जानकारी')}><a href={pathFor(lang,'admissions/pre-primary')}>{t('Starting school · Nursery & KG','स्कूल की शुरुआत · नर्सरी और केजी')} →</a><a href={pathFor(lang,'admissions/class-11')}>{t('After Class 10 · choosing a stream','दसवीं के बाद · संकाय का चयन')} →</a><a href="#budget">{t('Plan your budget','खर्च का अनुमान लगाएँ')} ↓</a><a href={pathFor(lang,'contact')+'#visit'}>{t('Arrange a visit','स्कूल आने का समय लें')} →</a></nav>
</div><ClassChooser lang={lang}/></div></section>
<style>.intake-cover{background:#f3efdf;padding:clamp(24px,5vw,66px) 0}.intake-grid{display:grid;gap:1.4rem}.intake-grid h1{font:550 clamp(2.25rem,5vw,4.8rem)/1.09 Georgia,'Noto Serif Devanagari',serif;color:#193b37;max-width:16ch;margin:.7rem 0}.intake-grid>div>p{max-width:44ch;line-height:1.65}.intake-grid nav{display:flex;flex-wrap:wrap;gap:.2rem 1.2rem;margin-top:1rem}.intake-grid nav a{display:inline-flex;align-items:center;min-height:42px;font-size:.9rem;color:#194c46;font-weight:700;text-decoration:underline;text-underline-offset:4px}
:global(html[lang=hi]) .intake-grid h1{line-height:1.27}
@media(min-width:820px){.intake-grid{grid-template-columns:.86fr 1.14fr;align-items:start;gap:5vw}.intake-grid nav{display:grid;justify-items:start}}</style>
