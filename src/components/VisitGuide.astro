---
import Arrow from './Arrow.astro';
import { pathFor, pick, site, type Lang } from '../data/site';
import Photo from './Photo.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = (en: string, hi: string) => pick(lang, en, hi);
---
<section class="inside-section visit-guide" id="visit" aria-labelledby="visit-title">
  <div class="wrap inside-split visit-guide__grid">
    <div>
      <h2 id="visit-title">{t('Find the campus', 'विद्यालय का पता')}</h2>
      <address>
        <strong>{t(site.fullName, 'श्री वीर पत्ता सीनियर सेकेंडरी स्कूल')}</strong>
        <span>{t('Opposite Mela Ground, Amet–Kelwa Road', 'मेला ग्राउंड के सामने, आमेट–केलवा रोड')}</span>
        <span>{t('Amet, Rajsamand, Rajasthan 313332', 'आमेट, राजसमंद, राजस्थान 313332')}</span>
      </address>
      <a class="button button-primary inside-primary" href={site.maps} target="_blank" rel="noopener noreferrer">
        {t('Directions on Google Maps', 'Google Maps पर रास्ता देखें')}<span aria-hidden="true"><Arrow direction="up-right"/></span>
      </a>
      <div class="visit-guide__note">
        <h3>{t('Before setting out', 'आने से पहले')}</h3>
        <p>{t('Call to confirm a day and time. Mention the class you are considering so the office can direct you to the right person. If your family needs a step-free entrance, ask which way to come in.', 'फ़ोन करके दिन और समय पक्का कर लें। जिस कक्षा के बारे में जानना है, वह बताएँ ताकि कार्यालय सही व्यक्ति से आपकी बात करा सके। बिना सीढ़ियों वाला रास्ता चाहिए तो प्रवेश द्वार के बारे में भी पूछ लें।')}</p>
        <a class="inside-link" href={pathFor(lang, 'gallery') + '?category=campus#photos'}>
          {t('See the campus in photographs', 'तस्वीरों में परिसर देखें')}<span aria-hidden="true"><Arrow/></span>
        </a>
      </div>
    </div>
    <figure class="inside-figure visit-guide__photo">
      <Photo id="campus-front" lang={lang} sizes="(min-width: 1260px) 600px, (min-width: 770px) 49vw, 94vw" />
      <figcaption>{t('The front steps and palm trees at the main school building.', 'मुख्य विद्यालय भवन के सामने की सीढ़ियाँ और ताड़ के पेड़।')}</figcaption>
    </figure>
  </div>
</section>
