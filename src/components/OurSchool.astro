---
import Arrow from './Arrow.astro';
import { pathFor, pick, type Lang } from '../data/site';
import Photo from './Photo.astro';
import VideoCard from './VideoCard.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = (en: string, hi: string) => pick(lang, en, hi);

const facts = [
  { label: t('Location', 'स्थान'), value: t('Amet, Rajsamand', 'आमेट, राजसमंद') },
  { label: t('School stages', 'कक्षाएँ'), value: t('Nursery to Class 12', 'नर्सरी से कक्षा 12') },
  { label: t('Board', 'बोर्ड'), value: t('RBSE, Rajasthan', 'माध्यमिक शिक्षा बोर्ड, राजस्थान') },
  { label: t('Classes 11–12', 'कक्षा 11–12'), value: t('Science, Commerce, Arts', 'विज्ञान, वाणिज्य, कला') },
];
const pupilStories = [
  {
    image: 'solar-system-visitors',
    title: t('Two visitors meet the planets', 'दो छोटे मेहमान और सौरमंडल'),
    text: t('At the 2023 student-led conference, two young visitors stop at the pupils’ solar-system display. Behind the painted planets, a handwritten card marks Jupiter.', '2023 के विद्यार्थी सम्मेलन में दो छोटे मेहमान बच्चों का बनाया सौरमंडल देखने रुके। रंगे हुए ग्रहों के पीछे एक कार्ड पर हाथ से “Jupiter” लिखा है।'),
  },
  {
    image: 'classroom-pupils-together',
    title: t('At the front desk', 'आगे की बेंच पर'),
    text: t('At a wooden desk, a pupil turns towards the classmate beside him. The school shared this classroom scene in its 2026 Children’s Day story.', 'आगे की बेंच पर एक बच्चा बगल में बैठी सहपाठी की ओर मुड़ा है। विद्यालय ने अपनी कक्षा की यह झलक बाल दिवस 2026 की स्टोरी में साझा की थी।'),
  },
  {
    image: 'dance-footwork',
    title: t('Keeping time together', 'साथ कदम मिलाना'),
    text: t('On the lawn, dancers in yellow skirts and pink sashes turn together. They are performing in the inter-house dance competition.', 'लॉन पर पीले घाघरे और गुलाबी दुपट्टे पहने बच्चे एक साथ घूमते हैं। यह अंतर-सदनीय नृत्य प्रतियोगिता की प्रस्तुति है।'),
  },
];
---
<section id="campus" class="inside-section" aria-labelledby="campus-title">
  <div class="wrap">
    <div class="inside-section-head">
      <h2 id="campus-title">{t('In the classroom and out on the lawn', 'कक्षा के भीतर और लॉन पर')}</h2>
      <a class="inside-link" href={pathFor(lang, 'gallery') + '#photos'}>
        {t('Open the school album', 'विद्यालय का एल्बम देखें')}<span aria-hidden="true"><Arrow/></span>
      </a>
    </div>
    <div class="inside-photo-series">
      {pupilStories.map(story => (
        <figure class="inside-figure inside-photo-story">
          <Photo id={story.image} lang={lang} phoneMaxWidth={800} sizes="(min-width: 1350px) 420px, (min-width: 770px) 31vw, 94vw" />
          <figcaption><strong>{story.title}</strong><span>{story.text}</span></figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<div class="inside-facts">
  <dl class="wrap inside-facts__list">
    {facts.map(fact => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}
  </dl>
</div>

<section class="inside-section inside-soft" aria-labelledby="campus-film">
  <div class="wrap inside-split inside-film">
    <div class="inside-copy">
      <h2 id="campus-film">{t('Where pupils learn and play', 'जहाँ बच्चे पढ़ते और खेलते हैं')}</h2>
      <p>{t('Follow the front steps into school in this short, silent photo tour. It takes you past the low tables for younger children, the labs and the basketball court. Call the office to arrange a visit.', 'इस छोटी, बिना आवाज़ वाली फ़िल्म में मुख्य सीढ़ियों से विद्यालय के अंदर आइए। तस्वीरों में छोटे बच्चों की मेज़ें, प्रयोगशालाएँ और बास्केटबॉल कोर्ट देखें। ख़ुद आने का समय कार्यालय से तय करें।')}</p>
      <a class="inside-link" href={pathFor(lang, 'contact') + '#visit'}>
        {t('Plan a campus visit', 'आने का रास्ता और समय जानें')}<span aria-hidden="true"><Arrow/></span>
      </a>
    </div>
    <VideoCard id="campus-spaces" lang={lang} large />
  </div>
</section>
