---
import { photos } from '../data/media';
import type { Lang } from '../data/site';

interface Art { id: string; media: string; sizes: string }
interface Props {
  id: string; lang: Lang; eager?: boolean; sizes?: string; class?: string;
  modern?: boolean; art?: Art;
}

const { id, lang, eager = false, sizes = '(min-width: 1000px) 50vw, 100vw', class: className, art } = Astro.props;
const photo = photos[id];
if (!photo) throw new Error(`Unknown public photograph: ${id}`);
const wide = art && photos[art.id];
if (art && !wide) throw new Error(`Unknown public photograph: ${art.id}`);

const srcset = (key: string, widths: number[], extension: string) =>
  widths.map(width => `/assets/media/photos/${key}-${width}.${extension} ${width}w`).join(', ');
const fallback = photo.widths.find(width => width >= 600 && width <= 800) ?? photo.widths[photo.widths.length - 1];
const attrs = {
  src: `/assets/media/photos/${id}-${fallback}.webp`,
  srcset: srcset(id, photo.widths, 'webp'),
  sizes, width: photo.w, height: photo.h,
  alt: photo.alt[lang], class: className,
  loading: eager ? 'eager' as const : 'lazy' as const,
  decoding: 'async' as const, fetchpriority: eager ? 'high' as const : 'auto' as const,
  style: photo.pos ? `object-position:${photo.pos}` : undefined,
};
---
{art || photo.avifWidths ? (
  <picture class="modern-photo">
    {art && wide && <>
      {wide.avifWidths && <source media={art.media} type="image/avif" srcset={srcset(art.id, wide.avifWidths, 'avif')} sizes={art.sizes} width={wide.w} height={wide.h} />}
      <source media={art.media} type="image/webp" srcset={srcset(art.id, wide.widths, 'webp')} sizes={art.sizes} width={wide.w} height={wide.h} />
    </>}
    {photo.avifWidths && <source type="image/avif" srcset={srcset(id, photo.avifWidths, 'avif')} sizes={sizes} />}
    <img {...attrs} />
  </picture>
) : <img {...attrs} />}
