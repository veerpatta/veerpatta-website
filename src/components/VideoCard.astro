---
import Photo from './Photo.astro';
import { photos, videos } from '../data/media';
import { pick, type Lang } from '../data/site';

interface Props { id: string; lang: Lang; large?: boolean }
const { id, lang, large = false } = Astro.props;
const film = videos[id];
if (!film) throw new Error(`Unknown public film: ${id}`);
const poster = photos[film.poster];
const posterWidth = poster.widths.find(width => width >= 640) ?? poster.w;
const posterUrl = `/assets/media/photos/${film.poster}-${posterWidth}.webp`;
const source = `/assets/media/videos/${film.file}`;
const { bytes } = film;
const size = bytes < 1_000_000 ? `${Math.round(bytes / 1000)} KB` : `${(bytes / 1_000_000).toFixed(1)} MB`;
const length = `${Math.floor(film.seconds / 60)}:${String(film.seconds % 60).padStart(2, '0')}`;
const t = (en: string, hi: string) => pick(lang, en, hi);
---
<figure class:list={['video-card', 'album-film', { large }]}>
  <a class="video-preview film-preview" href={source} data-video-src={source} data-video-id={id}
     aria-label={t(`Play ${film.caption.en}, ${film.seconds} seconds, ${size}`, `${film.caption.hi} चलाएँ, ${film.seconds} सेकंड, ${size}`)}>
    <Photo id={film.poster} lang={lang} sizes={large ? '(min-width: 1400px) 720px, (min-width: 800px) 53vw, 92vw' : '(min-width: 1350px) 620px, (min-width: 760px) 44vw, 92vw'} />
    <span class="film-play" aria-hidden="true">
      <svg viewBox="0 0 20 22" width="18" height="20" fill="currentColor"><path d="M3 1.5 18 11 3 20.5z"/></svg>
    </span>
    <span class="film-length" aria-hidden="true">{length} · {size}</span>
  </a>
  <template data-video-template>
    <video class="school-video film-player" src={source} poster={posterUrl} width={poster.w} height={poster.h}
           controls playsinline muted preload="none" tabindex="0" aria-label={film.caption[lang]}>
      {(['en', 'hi'] as const).map(language =>
        <track kind="captions" label={language === 'hi' ? 'हिंदी' : 'English'} srclang={language}
               src={`/assets/media/videos/${id}-${language}.vtt`} default={language === lang} />)}
    </video>
    <p class="film-error" data-video-error hidden>
      {t('The film could not play.', 'फ़िल्म नहीं चल पाई।')} <a href={source}>{t('Open the MP4 file', 'MP4 फ़ाइल खोलें')}</a>
    </p>
  </template>
  <figcaption>
    <strong>{film.caption[lang]}</strong>
    <span>{film.description[lang]}</span>
    <details class="film-scenes">
      <summary>{t('Read the scene descriptions', 'दृश्यों का विवरण पढ़ें')}</summary>
      <ol>{film.scenes.map(scene => <li><span class="scene-time" dir="ltr">0:{String(scene.start).padStart(2, '0')}</span> {scene[lang]}</li>)}</ol>
    </details>
  </figcaption>
</figure>
<style>
  .album-film { min-width:0; margin:0; color:inherit; }
  .film-preview, .album-film :global(.film-player) { display:block; width:100%; aspect-ratio:16 / 9; overflow:hidden; border-radius:0; background:#172e40; }
  .film-preview { position:relative; isolation:isolate; }
  .film-preview :global(img), .film-preview :global(picture) { display:block; width:100%; height:100%; object-fit:cover; }
  .film-preview::after { content:''; position:absolute; inset:0; background:linear-gradient(0deg,#14243260,transparent 48%); z-index:0; }
  .film-play { position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); display:grid; place-items:center; width:clamp(3rem,5vw,4.5rem); aspect-ratio:1; color:#762f39; background:#fffcf5; border-radius:50%; z-index:1; }
  .film-play svg { margin-inline-start:3px; }
  .film-length { position:absolute; right:.65rem; bottom:.65rem; background:#172e40; color:white; padding:.18rem .5rem; font-size:.76rem; font-variant-numeric:tabular-nums; z-index:1; }
  .album-film figcaption { display:grid; gap:.4rem; margin-top:.7rem; line-height:1.55; font-size:.92rem; font-weight:400; color:inherit; }
  .album-film figcaption strong { font-size:1.05rem; }
  .film-scenes { justify-self:start; }
  .film-scenes summary { display:list-item; cursor:pointer; padding:.25rem 0; color:inherit; text-decoration:underline; text-underline-offset:.18em; font-size:.83rem; }
  .film-scenes ol { margin:.45rem 0; padding:0; list-style:none; }
  .film-scenes li { display:flex; gap:.7rem; margin:.22rem 0; font-size:.84rem; }
  .scene-time { font-variant-numeric:tabular-nums; }
  .film-error { margin-top:.5rem; }
  .film-error a { text-decoration:underline; }
</style>
