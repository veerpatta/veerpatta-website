---
import Photo from './Photo.astro';
import { videos } from '../data/media';
import {pick,type Lang} from '../data/site';
interface Props {id:string;lang:Lang;large?:boolean}
const {id,lang,large=false}=Astro.props;
const v=videos[id];
if(!v) throw new Error(`Unknown video ${id}`);
const play=pick(lang,'Play video','वीडियो चलाएँ');
---
<figure class:list={['video-card',{large}]}>
  <a class="video-preview" href={`/assets/media/videos/${id}-720.mp4`} data-video-src={`/assets/media/videos/${id}-720.mp4`} data-video-title={v.caption[lang]} data-video-poster={`/assets/media/photos/${v.poster}-800.webp`} data-video-id={id} aria-label={`${play}: ${v.caption[lang]}`}>
    <Photo id={v.poster} lang={lang} sizes={large?'(min-width: 1000px) 70vw, 100vw':'(min-width: 900px) 33vw, 90vw'} />
    <span class="play-circle" aria-hidden="true"><svg width="22" height="24" viewBox="0 0 22 24" fill="currentColor"><path d="m5 3 15 9-15 9V3Z"/></svg></span>
    <span class="video-length">{v.duration} <span>· {v.size}</span></span>
  </a>
  <figcaption><span>{v.caption[lang]}</span><span class="video-tap">{pick(lang,'Tap to watch','देखने के लिए टैप करें')} <span aria-hidden="true">↗</span></span></figcaption>
</figure>
