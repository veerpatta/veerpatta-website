---
import Photo from './Photo.astro';
import VideoCard from './VideoCard.astro';
import {pick,pathFor,type Lang} from '../data/site';
interface Props {lang:Lang}
const {lang}=Astro.props;
const stages=[
 {no:'01',age:pick(lang,'Nursery & KG','नर्सरी और केजी'),title:pick(lang,'Small steps. Big discoveries.','छोटे कदम। बड़ी खोजें।'),body:pick(lang,'A first look at school, play and learning together.','स्कूल, खेल और साथ मिलकर सीखने की पहली शुरुआत।'),photo:'activity-room'},
 {no:'02',age:pick(lang,'Classes 1–5','कक्षा 1–5'),title:pick(lang,'Growing curious minds.','जिज्ञासु मन, नई शुरुआत।'),body:pick(lang,'Discover the primary years and everyday learning spaces.','प्राथमिक कक्षाओं और सीखने के माहौल को जानें।'),photo:'classroom-benches'},
 {no:'03',age:pick(lang,'Classes 6–10','कक्षा 6–10'),title:pick(lang,'More questions. More possibilities.','नए सवाल। नई संभावनाएँ।'),body:pick(lang,'Explore the middle years, secondary learning and RBSE pathway.','मिडिल और सेकेंडरी कक्षाओं की शिक्षा और आरबीएसई की राह जानें।'),photo:'learning-exhibition'},
 {no:'04',age:pick(lang,'Classes 11–12','कक्षा 11–12'),title:pick(lang,'A direction of their own.','अपनी पसंद, अपनी राह।'),body:pick(lang,'Science, Commerce and Arts. Talk to us about subjects and availability.','विज्ञान, वाणिज्य और कला। विषयों और उपलब्धता के बारे में हमसे बात करें।'),photo:'computer-lab-wide'}
];
const questions=[
 {n:'01',title:pick(lang,'Where do we start?','शुरुआत कहाँ से करें?'),body:pick(lang,'A simple admissions guide, a visit and a conversation with our office.','आसान प्रवेश जानकारी, परिसर का दौरा और कार्यालय से बातचीत।'),link:'admissions',cta:pick(lang,'Understand admissions','प्रवेश की प्रक्रिया जानें')},
 {n:'02',title:pick(lang,'What will my child learn?','मेरा बच्चा क्या सीखेगा?'),body:pick(lang,'Get to know our learning stages, classrooms and RBSE pathway.','शिक्षा के चरणों, कक्षाओं और आरबीएसई की पढ़ाई को जानें।'),link:'academics',cta:pick(lang,'Explore learning','शिक्षा के बारे में जानें')},
 {n:'03',title:pick(lang,'Can we come and see?','क्या हम स्कूल देखने आ सकते हैं?'),body:pick(lang,'Find us in Amet. Ask about a suitable visit time and transport options.','आमेट में हमसे मिलें। आने के समय और परिवहन विकल्पों के बारे में पूछें।'),link:'contact',cta:pick(lang,'Talk to the school','स्कूल से बात करें')}
];
---
<section class="home-hero"><div class="wrap hero-grid"><div class="hero-copy"><p class="eyebrow"><span class="eyebrow-line"></span>{pick(lang,'Rooted in Amet. Open to possibility.','आमेट से जुड़ाव। नई संभावनाओं की ओर।')}</p><h1>{pick(lang,'A place to learn.','सीखने की जगह।')}<br/><em>{pick(lang,'A world to discover.','नई दुनिया की खोज।')}</em></h1><p class="hero-description">{pick(lang,'Big dreams begin with everyday discoveries. Welcome to Veerpatta, where school life is about learning, friendship and finding your own way.','बड़े सपने रोज़ की छोटी खोजों से शुरू होते हैं। वीरपट्टा में आपका स्वागत है, जहाँ स्कूल जीवन का मतलब सीखना, दोस्ती और अपनी राह तलाशना है।')}</p><div class="hero-actions"><a href={pathFor(lang,'admissions')} class="button button-primary">{pick(lang,'Start your journey','अपना सफ़र शुरू करें')}<span aria-hidden="true">↗</span></a><a href="#school-film" class="hero-film-link"><span class="tiny-play" aria-hidden="true">▶</span>{pick(lang,'Take a little look','स्कूल की एक झलक देखें')}</a></div><div class="hero-footnote"><span class="little-sun" aria-hidden="true">✳</span><div><strong>{pick(lang,'Nursery to Class XII','नर्सरी से कक्षा 12')}</strong><span>{pick(lang,'A school journey, all in one place.','स्कूली सफ़र, एक ही परिसर में।')}</span></div></div></div><div class="hero-visual"><div class="hero-photo"><Photo id="campus-lawn" lang={lang} eager={true} sizes="(min-width: 1000px) 52vw, 100vw"/><div class="photo-stamp"><span class="stamp-dot"></span>{pick(lang,'Our school. Our everyday.','हमारा स्कूल। हमारी रोज़ की दुनिया।')}</div></div><div class="hero-postcard"><span class="postcard-icon" aria-hidden="true"><svg width="31" height="32" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M3 27V13l13-9 13 9v14H3ZM12 27v-8h8v8M9 14h3m8 0h3M16 4v-3m0 0h7v4h-7"/></svg></span><div><span>{pick(lang,'A little closer to home.','अपने घर के और क़रीब।')}</span><strong>{pick(lang,'A little bigger on dreams.','सपनों में और आगे।')}</strong></div></div><span class="hero-scribble" aria-hidden="true"><svg width="94" height="89" viewBox="0 0 94 89" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 61C15 28 56 9 70 31c15 23-24 44-33 28C28 44 67 43 84 66M84 66l-19-1m19 1-9-17"/></svg></span><span class="hero-coordinate">AMET · RAJASTHAN · INDIA</span></div></div></section>
<div class="identity-strip"><div class="wrap identity-grid"><div><span>01</span><strong>{pick(lang,'RBSE curriculum','आरबीएसई पाठ्यक्रम')}</strong></div><div><span>02</span><strong>{pick(lang,'Nursery to XII','नर्सरी से 12वीं')}</strong></div><div><span>03</span><strong>{pick(lang,'Science · Commerce · Arts','विज्ञान · वाणिज्य · कला')}</strong></div><div><span>04</span><strong>{pick(lang,'Amet, Rajasthan','आमेट, राजस्थान')}</strong></div></div></div>
<section class="section welcome-section"><div class="wrap"><div class="section-head"><div><p class="eyebrow">{pick(lang,'For parents, first','सबसे पहले, अभिभावकों के लिए')}</p><h2>{pick(lang,'Choosing a school,','स्कूल चुनना,')}<br/><em>{pick(lang,'made a little simpler.','अब थोड़ा आसान।')}</em></h2></div><p class="section-intro">{pick(lang,'You have questions. Let’s start with the ones that matter most to your family.','आपके मन में सवाल हैं। शुरुआत उन सवालों से करें जो आपके परिवार के लिए सबसे ज़रूरी हैं।')}</p></div><div class="parent-questions">{questions.map(q=><a href={pathFor(lang,q.link)} class="question-card" data-reveal><span class="card-number">{q.n}</span><h3>{q.title}</h3><p>{q.body}</p><span class="text-link">{q.cta}<span aria-hidden="true">↗</span></span></a>)}</div></div></section>
<section class="film-section section-navy" id="school-film"><div class="wrap film-grid"><div class="film-copy"><p class="eyebrow">{pick(lang,'A school, full of life','ज़िंदगी से भरा स्कूल')}</p><h2>{pick(lang,'Little moments.','छोटे-छोटे पल।')}<br/><em>{pick(lang,'Lasting possibilities.','बड़ी-बड़ी संभावनाएँ।')}</em></h2><p>{pick(lang,'The first steps through the gate. A finish line crossed. A dance with friends. This is a small glimpse of the places and moments that make our school.','स्कूल के गेट से पहला कदम। दौड़ की फ़िनिश लाइन। दोस्तों के साथ नृत्य। यही जगहें और पल हमारे स्कूल की पहचान हैं।')}</p><p class="film-note">{pick(lang,'A 24-second edited film made from real school photographs. Silent, with descriptive captions.','स्कूल की असली तस्वीरों से बनी 24 सेकंड की संपादित फ़िल्म। बिना आवाज़, दृश्य विवरण के साथ।')}</p><a href={pathFor(lang,'gallery')} class="text-link text-link-light">{pick(lang,'More photos & films','और तस्वीरें और फ़िल्में')}<span aria-hidden="true">↗</span></a></div><div class="film-screen" data-reveal><VideoCard id="school-story" lang={lang} large={true}/></div></div></section>
<section class="section learning-section"><div class="wrap"><div class="section-head"><div><p class="eyebrow">{pick(lang,'A journey of their own','उनका अपना सफ़र')}</p><h2>{pick(lang,'Room to grow,','आगे बढ़ने की जगह,')}<br/><em>{pick(lang,'at every age.','हर उम्र में।')}</em></h2></div><a href={pathFor(lang,'academics')} class="button button-outline">{pick(lang,'Explore academics','शिक्षा के बारे में जानें')}<span aria-hidden="true">↗</span></a></div><div class="learning-grid">{stages.map(s=><a href={pathFor(lang,'academics')} class="learning-card" data-reveal><div class="learning-photo"><Photo id={s.photo} lang={lang} sizes="(min-width: 1000px) 24vw, (min-width: 600px) 45vw, 92vw"/><span class="stage-badge">{s.age}</span></div><div class="learning-copy"><h3>{s.title}</h3><p>{s.body}</p><span class="stage-arrow" aria-hidden="true">↗</span></div></a>)}</div></div></section>
<section class="section section-soft life-section"><div class="wrap life-grid"><div class="life-mosaic"><div class="life-photo-wide" data-reveal><Photo id="sports-drill" lang={lang}/><span>{pick(lang,'Together, on the field','मैदान में, एक साथ')}</span></div><div class="life-photo-small" data-reveal><Photo id="ncc-cadets" lang={lang}/></div><div class="life-words"><span aria-hidden="true">✳</span><p>{pick(lang,'Find your people.','अपने दोस्त ढूँढें।')}<br/><em>{pick(lang,'Find your spark.','अपनी चमक पाएँ।')}</em></p></div></div><div class="life-copy"><p class="eyebrow">{pick(lang,'Beyond the classroom','कक्षा की चारदीवारी से आगे')}</p><h2>{pick(lang,'School days.','स्कूल के दिन।')}<br/><em>{pick(lang,'So much more.','और भी बहुत कुछ।')}</em></h2><p class="lead">{pick(lang,'There’s a whole world beyond a textbook. See our school’s sporting moments, NCC cadets, cultural performances and shared celebrations.','किताबों के बाहर भी एक दुनिया है। हमारे खेल के पल, एनसीसी कैडेट, सांस्कृतिक प्रस्तुतियाँ और मिलकर मनाए उत्सव देखें।')}</p><ul class="life-list"><li>{pick(lang,'On the field','खेल के मैदान में')}<span>{pick(lang,'Sports & team spirit','खेल और टीम भावना')}</span></li><li>{pick(lang,'On the stage','मंच पर')}<span>{pick(lang,'Dance & expression','नृत्य और अभिव्यक्ति')}</span></li><li>{pick(lang,'Standing together','एक साथ कदम बढ़ाते')}<span>{pick(lang,'NCC & school community','एनसीसी और स्कूल परिवार')}</span></li></ul><a href={pathFor(lang,'beyond')} class="text-link">{pick(lang,'Discover school life','स्कूल जीवन को जानें')}<span aria-hidden="true">↗</span></a></div></div></section>
<section class="section campus-section"><div class="wrap"><div class="section-head"><div><p class="eyebrow">{pick(lang,'A real look around','परिसर की असली झलक')}</p><h2>{pick(lang,'See the spaces','उन जगहों को देखें')}<br/><em>{pick(lang,'behind the stories.','जहाँ कहानियाँ बनती हैं।')}</em></h2></div><p class="section-intro">{pick(lang,'Our campus, as it is. Explore real photographs from classrooms, courtyards and everyday school life.','हमारा परिसर, जैसा है। कक्षाओं, प्रांगण और रोज़ के स्कूल जीवन की असली तस्वीरें देखें।')}</p></div><div class="campus-grid">{[{id:'campus-front',title:pick(lang,'A familiar welcome','अपनापन भरा स्वागत'),tag:pick(lang,'Our campus','हमारा परिसर')},{id:'classroom-benches',title:pick(lang,'A place for discovery','खोज की एक जगह'),tag:pick(lang,'Learning spaces','सीखने का माहौल')},{id:'dance-lawn',title:pick(lang,'A moment to shine','चमकने का एक पल'),tag:pick(lang,'School life','स्कूल जीवन')}].map(p=><a href={pathFor(lang,'gallery')} class="campus-card" data-reveal><Photo id={p.id} lang={lang} sizes="(min-width: 900px) 33vw, 92vw"/><div><span>{p.tag}</span><h3>{p.title}</h3><span class="campus-arrow" aria-hidden="true">↗</span></div></a>)}</div><div class="center-actions"><a href={pathFor(lang,'gallery')} class="button button-outline">{pick(lang,'Explore our gallery','हमारी गैलरी देखें')}<span aria-hidden="true">↗</span></a><span class="authentic-note"><span aria-hidden="true">○</span>{pick(lang,'Real school. Real photographs.','असली स्कूल। असली तस्वीरें।')}</span></div></div></section>
<section class="section section-soft"><div class="wrap home-faq-grid"><div><p class="eyebrow">{pick(lang,'A few useful answers','कुछ काम के जवाब')}</p><h2>{pick(lang,'Good questions.','अच्छे सवाल।')}<br/><em>{pick(lang,'Clear next steps.','आसान अगले कदम।')}</em></h2><p class="section-intro">{pick(lang,'A little clarity before you get in touch. We’re happy to talk through the details.','संपर्क करने से पहले कुछ जानकारी। बाकी सवालों पर हमसे बात करें।')}</p><a class="text-link" href={pathFor(lang,'faq')}>{pick(lang,'All common questions','सभी आम सवाल')}<span aria-hidden="true">↗</span></a></div><div class="faq-list">{[
 [pick(lang,'Which classes does the school offer?','स्कूल में कौन-सी कक्षाएँ हैं?'),pick(lang,'Nursery to Class 12, with the RBSE pathway and Science, Commerce and Arts at senior secondary level. Please confirm subject combinations and current availability with the office.','नर्सरी से कक्षा 12 तक, आरबीएसई पाठ्यक्रम और सीनियर सेकेंडरी में विज्ञान, वाणिज्य और कला। विषयों और वर्तमान उपलब्धता की जानकारी कार्यालय से लें।')],
 [pick(lang,'How can I find out about fees?','शुल्क की जानकारी कैसे मिलेगी?'),pick(lang,'Ask the office for the current written fee structure for your child’s class. Our admissions page includes a budget planner for amounts from that quote.','अपने बच्चे की कक्षा के लिए वर्तमान लिखित शुल्क विवरण कार्यालय से लें। प्रवेश पेज पर मिले हुए विवरण से बजट बनाने का टूल भी है।')],
 [pick(lang,'Can we visit before deciding?','क्या निर्णय लेने से पहले स्कूल देख सकते हैं?'),pick(lang,'Of course. Call or send an enquiry to ask about a suitable visit time. The office must confirm your visit; submitting an enquiry does not book a slot.','ज़रूर। सुविधाजनक समय पूछने के लिए कॉल करें या पूछताछ भेजें। आपके आने का समय कार्यालय से पक्का होगा; पूछताछ भेजने से समय बुक नहीं होता।')],
 [pick(lang,'How do we ask about transport?','परिवहन के बारे में कैसे पूछें?'),pick(lang,'Share your village or area with the office by phone or WhatsApp. Confirm route, pickup location, availability and charges directly before making plans.','फ़ोन या WhatsApp पर अपने गाँव या क्षेत्र का नाम बताएँ। रूट, पिकअप स्थान, उपलब्धता और शुल्क कार्यालय से पक्का करें।')]
 ].map(([q,a])=><details><summary>{q}<span aria-hidden="true">+</span></summary><p>{a}</p></details>)}</div></div></section>
