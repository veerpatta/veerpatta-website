---
import Arrow from './Arrow.astro';
import SchoolHero from './SchoolHero.astro';
import Photo from './Photo.astro';
import VideoCard from './VideoCard.astro';
import { pick, pathFor, type Lang } from '../data/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = (en: string, hi: string) => pick(lang, en, hi);
const stages = [
  { label:t('Nursery & KG', 'नर्सरी और केजी'), photo:'first-school-room', body:t('A look at the activity room and questions to ask before a first school visit.', 'गतिविधि कक्ष की झलक और पहली मुलाक़ात में पूछने लायक बातें।'), href:'admissions/pre-primary/' },
  { label:t('Classes 1–5', 'कक्षा 1–5'), photo:'place-value-table', body:t('Place-value blocks, projects and English groups that follow each child’s learning level.', 'स्थानीय मान के लिए ब्लॉक, प्रोजेक्ट और सीखने के स्तर के अनुसार अंग्रेज़ी के समूह।'), href:'academics/#elga' },
  { label:t('Classes 6–10', 'कक्षा 6–10'), photo:'angles-board', body:t('Explore a working angle wheel and the path to the Class 10 RBSE examination.', 'कोण मापने का मॉडल देखें और दसवीं की बोर्ड परीक्षा तक की पढ़ाई को जानें।'), href:'academics/#middle' },
  { label:t('Classes 11–12', 'कक्षा 11–12'), photo:'science-bench', body:t('Science, Commerce or Arts. Discuss subject combinations with the school office.', 'विज्ञान, वाणिज्य या कला। विषयों का चुनाव करने से पहले विद्यालय कार्यालय से बात करें।'), href:'admissions/class-11/' }
];
---
<SchoolHero lang={lang}/>
<section class="stage-section" aria-labelledby="stages-title">
  <div class="wrap">
    <div class="spread-heading"><h2 id="stages-title">{t('Find your child’s class', 'अपने बच्चे की कक्षा चुनें')}</h2><a class="index-link" href={pathFor(lang,'admissions')+'#classes'}>{t('All admission options', 'प्रवेश के सभी विकल्प')} <span aria-hidden="true"><Arrow/></span></a></div>
    <div class="stage-index">{stages.map(stage =>
      <a class="stage-link" href={pathFor(lang)+stage.href}>
        <div class="stage-image"><Photo id={stage.photo} lang={lang} modern sizes="(min-width: 1000px) 23vw, (min-width: 600px) 43vw, 105px"/></div>
        <div class="stage-text"><h3>{stage.label}</h3><p>{stage.body}</p></div><span class="stage-go" aria-hidden="true"><Arrow direction="up-right"/></span>
      </a>)}</div>
  </div>
</section>
<section class="home-project" aria-labelledby="project-title"><div class="wrap project-spread">
  <figure><Photo id="circulatory-model" lang={lang} phoneMaxWidth={640} sizes="(min-width: 800px) 50vw, 100vw"/><figcaption>{t('Heart and lungs model, school learning exhibition', 'विद्यालय की प्रदर्शनी में हृदय और फेफड़ों का मॉडल')}</figcaption></figure>
  <div><p class="location-line">{t('At the exhibition', 'सीखने की प्रदर्शनी')}</p>
  <h2 id="project-title">{t('How does blood move through the body?', 'शरीर में खून कैसे बहता है?')}</h2>
  <p>{t('Follow the tubes on this model of the heart and lungs. At the exhibition, a working angle wheel and a miniature greenhouse show other ways pupils have turned schoolwork into models.', 'मॉडल में लगी नलियों का रास्ता देखकर समझिए कि खून कहाँ से गुज़रता है। प्रदर्शनी में बच्चों ने कोण मापने का चक्र और एक छोटा ग्रीनहाउस भी बनाया।')}</p>
  <a class="index-link" href={pathFor(lang,'academics')+'#exhibitions'}>{t('Explore the exhibition', 'प्रदर्शनी देखें')} <span aria-hidden="true"><Arrow/></span></a></div>
</div></section>
<section class="school-album" id="school-film"><div class="wrap album-grid">
  <div><p class="location-line">{t('Around the campus', 'परिसर की झलक')}</p><h2>{t('A walk through the school', 'चलिए, स्कूल देखें')}</h2>
  <p>{t('See the spaces before you visit. Tap to play a short, silent film made from school photographs.', 'आने से पहले स्कूल को देख लें। स्कूल की तस्वीरों से बनी यह छोटी, मूक फ़िल्म देखने के लिए टैप करें।')}</p>
  <a class="index-link" href={pathFor(lang,'gallery')}>{t('Open the school album', 'विद्यालय का एल्बम खोलें')} <span aria-hidden="true"><Arrow/></span></a></div>
  <VideoCard id="campus-spaces" lang={lang} large/>
</div></section>
<section class="life-directory"><div class="wrap life-directory-inner">
  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M12 2v20M2 12h20M5 5l14 14M5 19 19 5"/></svg>
  <div><h2>{t('School life in Amet', 'आमेट में स्कूली जीवन')}</h2><p>{t('Meet the four houses and read about NCC at Veer Patta.', 'वीर पत्ता के चारों सदनों और एनसीसी के बारे में जानें।')}</p></div>
  <a class="index-link" href={pathFor(lang,'beyond')}>{t('Explore school life', 'स्कूल जीवन देखें')} <span aria-hidden="true"><Arrow/></span></a>
</div></section>
