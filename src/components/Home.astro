---
import SchoolHero from './SchoolHero.astro';
import DecisionRail from './DecisionRail.astro';
import Photo from './Photo.astro';
import VideoCard from './VideoCard.astro';
import {pick,pathFor,type Lang} from '../data/site';
interface Props {lang:Lang}
const {lang}=Astro.props;
const stages=[
 {no:'01',age:pick(lang,'Nursery & KG','नर्सरी और केजी'),title:pick(lang,'Small steps. Big discoveries.','छोटे कदम। बड़ी खोजें।'),body:pick(lang,'A first look at school, play and learning together.','स्कूल, खेल और साथ मिलकर सीखने की पहली शुरुआत।'),photo:'early-years-dance'},
 {no:'02',age:pick(lang,'Classes 1–5','कक्षा 1–5'),title:pick(lang,'Growing curious minds.','जिज्ञासु मन, नई शुरुआत।'),body:pick(lang,'Discover the primary years and everyday learning spaces.','प्राथमिक कक्षाओं और सीखने के माहौल को जानें।'),photo:'seasons-model'},
 {no:'03',age:pick(lang,'Classes 6–10','कक्षा 6–10'),title:pick(lang,'More questions. More possibilities.','नए सवाल। नई संभावनाएँ।'),body:pick(lang,'Explore the middle years, secondary learning and RBSE pathway.','मिडिल और सेकेंडरी कक्षाओं की शिक्षा और आरबीएसई की राह जानें।'),photo:'angles-board'},
 {no:'04',age:pick(lang,'Classes 11–12','कक्षा 11–12'),title:pick(lang,'A direction of their own.','अपनी पसंद, अपनी राह।'),body:pick(lang,'Science, Commerce and Arts. Talk to us about subjects and availability.','विज्ञान, वाणिज्य और कला। विषयों और उपलब्धता के बारे में हमसे बात करें।'),photo:'greenhouse-model'}
];
---
<SchoolHero lang={lang} /><DecisionRail lang={lang} />
<section class="film-section section-navy" id="school-film"><div class="wrap film-grid"><div class="film-copy"><p class="eyebrow">{pick(lang,'A school, full of life','ज़िंदगी से भरा स्कूल')}</p><h2>{pick(lang,'One school day,','हमारे स्कूल की')}<br/><em>{pick(lang,'in pictures.','एक छोटी फ़िल्म।')}</em></h2><p>{pick(lang,'The first steps through the gate. A finish line crossed. A dance with friends. This is a small glimpse of the places and moments that make our school.','स्कूल के गेट से पहला कदम। दौड़ की फ़िनिश लाइन। दोस्तों के साथ नृत्य। यही जगहें और पल हमारे स्कूल की पहचान हैं।')}</p><p class="film-note">{pick(lang,'A 24-second edited film made from real school photographs. Silent, with descriptive captions.','स्कूल की असली तस्वीरों से बनी 24 सेकंड की संपादित फ़िल्म। बिना आवाज़, दृश्य विवरण के साथ।')}</p><a href={pathFor(lang,'gallery')} class="text-link text-link-light">{pick(lang,'More photos & films','और तस्वीरें और फ़िल्में')}<span aria-hidden="true">→</span></a></div><div class="film-screen" data-reveal><VideoCard id="school-story" lang={lang} large={true}/></div></div></section>
<section class="section learning-section"><div class="wrap"><div class="section-head"><div><p class="eyebrow">{pick(lang,'A journey of their own','उनका अपना सफ़र')}</p><h2>{pick(lang,'Room to grow,','आगे बढ़ने की जगह,')}<br/><em>{pick(lang,'at every age.','हर उम्र में।')}</em></h2></div><a href={pathFor(lang,'academics')} class="button button-outline">{pick(lang,'Explore academics','शिक्षा के बारे में जानें')}<span aria-hidden="true">→</span></a></div><div class="learning-grid">{stages.map(s=><a href={pathFor(lang,s.no==='01'?'admissions/pre-primary':s.no==='04'?'admissions/class-11':'academics')} class="learning-card" data-reveal><div class="learning-photo"><Photo id={s.photo} lang={lang} modern={s.no==='01'} sizes="(min-width: 1000px) 24vw, (min-width: 600px) 45vw, 92vw"/><span class="stage-badge">{s.age}</span></div><div class="learning-copy"><h3>{s.title}</h3><p>{s.body}</p><span class="stage-arrow" aria-hidden="true">→</span></div></a>)}</div></div></section>
<section class="section section-soft life-section"><div class="wrap life-grid"><div class="life-mosaic"><div class="life-photo-wide" data-reveal><Photo id="sports-drill" lang={lang} sizes="(min-width: 900px) 45vw, 92vw"/><span>{pick(lang,'Together, on the field','मैदान में, एक साथ')}</span></div><div class="life-photo-small" data-reveal><Photo id="ncc-cadets" lang={lang} sizes="(min-width: 900px) 22vw, 46vw"/></div><div class="life-words"><span aria-hidden="true">✳︎</span><p>{pick(lang,'Find your people.','अपने दोस्त ढूँढें।')}<br/><em>{pick(lang,'Find your spark.','अपनी चमक पाएँ।')}</em></p></div></div><div class="life-copy"><p class="eyebrow">{pick(lang,'Beyond the classroom','कक्षा की चारदीवारी से आगे')}</p><h2>{pick(lang,'School days.','स्कूल के दिन।')}<br/><em>{pick(lang,'So much more.','और भी बहुत कुछ।')}</em></h2><p class="lead">{pick(lang,'There’s a whole world beyond a textbook. See our school’s sporting moments, NCC cadets, cultural performances and shared celebrations.','किताबों के बाहर भी एक दुनिया है। हमारे खेल के पल, एनसीसी कैडेट, सांस्कृतिक प्रस्तुतियाँ और मिलकर मनाए उत्सव देखें।')}</p><ul class="life-list"><li>{pick(lang,'On the field','खेल के मैदान में')}<span>{pick(lang,'Sports & team spirit','खेल और टीम भावना')}</span></li><li>{pick(lang,'On the stage','मंच पर')}<span>{pick(lang,'Dance & expression','नृत्य और अभिव्यक्ति')}</span></li><li>{pick(lang,'Standing together','एक साथ कदम बढ़ाते')}<span>{pick(lang,'NCC & school community','एनसीसी और स्कूल परिवार')}</span></li></ul><a href={pathFor(lang,'beyond')} class="text-link">{pick(lang,'Discover school life','स्कूल जीवन को जानें')}<span aria-hidden="true">→</span></a></div></div></section>
<section class="section campus-section"><div class="wrap"><div class="section-head"><div><p class="eyebrow">{pick(lang,'A real look around','परिसर की असली झलक')}</p><h2>{pick(lang,'See the spaces','उन जगहों को देखें')}<br/><em>{pick(lang,'behind the stories.','जहाँ कहानियाँ बनती हैं।')}</em></h2></div><p class="section-intro">{pick(lang,'Our campus, as it is. Explore real photographs from classrooms, courtyards and everyday school life.','हमारा परिसर, जैसा है। कक्षाओं, प्रांगण और रोज़ के स्कूल जीवन की असली तस्वीरें देखें।')}</p></div><div class="campus-grid">{[{id:'campus-front',title:pick(lang,'A familiar welcome','अपनापन भरा स्वागत'),tag:pick(lang,'Our campus','हमारा परिसर')},{id:'campus-lawn',title:pick(lang,'Room to run and play','दौड़ने-खेलने की खुली जगह'),tag:pick(lang,'School life','स्कूल जीवन')},{id:'football-goal',title:pick(lang,'Football on the school lawn','स्कूल के लॉन पर फ़ुटबॉल'),tag:pick(lang,'Sport','खेल')}].map(p=><a href={pathFor(lang,'gallery')} class="campus-card" data-reveal><Photo id={p.id} lang={lang} sizes="(min-width: 900px) 33vw, 92vw"/><div><span>{p.tag}</span><h3>{p.title}</h3><span class="campus-arrow" aria-hidden="true">→</span></div></a>)}</div><div class="center-actions"><a href={pathFor(lang,'gallery')} class="button button-outline">{pick(lang,'Explore our gallery','हमारी गैलरी देखें')}<span aria-hidden="true">→</span></a><span class="authentic-note"><span aria-hidden="true">○</span>{pick(lang,'Real school. Real photographs.','असली स्कूल। असली तस्वीरें।')}</span></div></div></section>
<section class="section section-soft"><div class="wrap home-faq-grid"><div><p class="eyebrow">{pick(lang,'A few useful answers','कुछ काम के जवाब')}</p><h2>{pick(lang,'Good questions.','अच्छे सवाल।')}<br/><em>{pick(lang,'Clear next steps.','आसान अगले कदम।')}</em></h2><p class="section-intro">{pick(lang,'A little clarity before you get in touch. We’re happy to talk through the details.','संपर्क करने से पहले कुछ जानकारी। बाकी सवालों पर हमसे बात करें।')}</p><a class="text-link" href={pathFor(lang,'faq')}>{pick(lang,'All common questions','सभी आम सवाल')}<span aria-hidden="true">→</span></a></div><div class="faq-list">{[
 [pick(lang,'Which classes does the school offer?','स्कूल में कौन-सी कक्षाएँ हैं?'),pick(lang,'Nursery to Class 12, with the RBSE pathway and Science, Commerce and Arts at senior secondary level. Please confirm subject combinations and current availability with the office.','नर्सरी से कक्षा 12 तक, आरबीएसई पाठ्यक्रम और सीनियर सेकेंडरी में विज्ञान, वाणिज्य और कला। विषयों और वर्तमान उपलब्धता की जानकारी कार्यालय से लें।')],
 [pick(lang,'How can I find out about fees?','शुल्क की जानकारी कैसे मिलेगी?'),pick(lang,'Ask the office for the current written fee structure for your child’s class. Our admissions page includes a budget planner for amounts from that quote.','अपने बच्चे की कक्षा के लिए वर्तमान लिखित शुल्क विवरण कार्यालय से लें। प्रवेश पेज पर मिले हुए विवरण से बजट बनाने का टूल भी है।')],
 [pick(lang,'Can we visit before deciding?','क्या निर्णय लेने से पहले स्कूल देख सकते हैं?'),pick(lang,'Of course. Call or send an enquiry to ask about a suitable visit time. The office must confirm your visit; submitting an enquiry does not book a slot.','ज़रूर। सुविधाजनक समय पूछने के लिए कॉल करें या पूछताछ भेजें। आपके आने का समय कार्यालय से पक्का होगा; पूछताछ भेजने से समय बुक नहीं होता।')],
 [pick(lang,'How do we ask about transport?','परिवहन के बारे में कैसे पूछें?'),pick(lang,'Tell the school office your village or area by phone. Confirm route, pickup location, availability and charges directly before making plans.','कार्यालय में फ़ोन करके अपने गाँव या क्षेत्र का नाम बताएँ। रूट, पिकअप स्थान, उपलब्धता और शुल्क कार्यालय से पक्का करें।')]
 ].map(([q,a])=><details><summary>{q}<span aria-hidden="true">+</span></summary><p>{a}</p></details>)}</div></div></section>
