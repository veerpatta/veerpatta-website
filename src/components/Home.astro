---
import Arrow from './Arrow.astro';
import SchoolHero from './SchoolHero.astro';
import Photo from './Photo.astro';
import VideoCard from './VideoCard.astro';
import { pick, pathFor, type Lang } from '../data/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = (en: string, hi: string) => pick(lang, en, hi);
const stages = [
  { label:t('Nursery & KG', 'नर्सरी और केजी'), photo:'junior-track-games-2025', body:t('Start with a glimpse of the early-years track games. Plan a first visit for Nursery, Junior KG or Senior KG.', 'छोटे बच्चों के खेलों की झलक देखें। नर्सरी, जूनियर केजी या सीनियर केजी के लिए विद्यालय आने की जानकारी लें।'), href:'admissions/pre-primary/' },
  { label:t('Classes 1–5', 'कक्षा 1–5'), photo:'place-value-table', body:t('Place-value blocks, projects and English groups that follow each child’s learning level.', 'स्थानीय मान के लिए ब्लॉक, प्रोजेक्ट और सीखने के स्तर के अनुसार अंग्रेज़ी के समूह।'), href:'academics/#elga' },
  { label:t('Classes 6–10', 'कक्षा 6–10'), photo:'basketball-court', body:t('Spot geometry on the basketball court. Follow the stages of learning up to the Class 10 board exams.', 'बास्केटबॉल कोर्ट पर ज्यामिति तलाशें। जानें कि छठी से दसवीं की बोर्ड परीक्षा तक पढ़ाई कैसे आगे बढ़ती है।'), href:'academics/#middle' },
  { label:t('Classes 11–12', 'कक्षा 11–12'), photo:'greenhouse-exhibition-group', body:t('After Class 10, explore Arts, Science and Commerce. Ask the office which subjects you can take together.', 'दसवीं के बाद कला, विज्ञान और वाणिज्य के बारे में जानें। विषयों के विकल्प समझने के लिए कार्यालय से बात करें।'), href:'admissions/class-11/' }
];
---
<SchoolHero lang={lang}/>
<section class="stage-section" aria-labelledby="stages-title">
  <div class="wrap">
    <div class="spread-heading"><h2 id="stages-title">{t('Find your child’s class', 'अपने बच्चे की कक्षा चुनें')}</h2><a class="index-link" href={pathFor(lang,'admissions')+'#classes'}>{t('All admission options', 'प्रवेश के सभी विकल्प')} <span aria-hidden="true"><Arrow/></span></a></div>
    <div class="stage-index">{stages.map(stage =>
      <a class="stage-link" href={pathFor(lang)+stage.href}>
        <div class="stage-image"><Photo id={stage.photo} lang={lang} sizes="(min-width: 1460px) 315px, (min-width: 1000px) 23vw, (min-width: 600px) 43vw, (min-width: 391px) 90px, 80px"/></div>
        <div class="stage-text"><h3>{stage.label}</h3><p>{stage.body}</p></div><span class="stage-go" aria-hidden="true"><Arrow direction="up-right"/></span>
      </a>)}</div>
  </div>
</section>
<section class="home-project" aria-labelledby="project-title"><div class="wrap project-spread">
  <figure><Photo id="nutrition-presentation" lang={lang} phoneMaxWidth={640} sizes="(min-width: 800px) 50vw, 100vw"/><figcaption>{t('Pupils present their food pyramid · 2023', 'बच्चों का बनाया भोजन पिरामिड · 2023')}</figcaption></figure>
  <div><p class="location-line">{t('From the school album', 'विद्यालय के एल्बम से')}</p>
  <h2 id="project-title">{t('What goes on each shelf?', 'किस खाने को कहाँ रखें?')}</h2>
  <p>{t('Look closely at this handmade food pyramid. For their 2023 student-led conference, pupils arranged pictures of food in tiers and presented the model to visitors. Which foods can your child spot?', 'ज़रा इस पिरामिड को देखिए। 2023 के विद्यार्थी सम्मेलन के लिए बच्चों ने खाने की चीज़ों के चित्र अलग-अलग स्तरों पर सजाए और अपना मॉडल आगंतुकों को दिखाया। आपके बच्चे को कौन-कौन सी चीज़ें दिखती हैं?')}</p>
  <a class="index-link" href={pathFor(lang,'academics')+'#exhibitions'}>{t('Explore the exhibition', 'प्रदर्शनी देखें')} <span aria-hidden="true"><Arrow/></span></a></div>
</div></section>
<section class="school-album" id="school-film"><div class="wrap album-grid">
  <div><p class="location-line">{t('Around the campus', 'परिसर की झलक')}</p><h2>{t('A walk through the school', 'चलिए, स्कूल देखें')}</h2>
  <p>{t('See the spaces before you visit. Tap to play a short, silent film made from school photographs.', 'आने से पहले स्कूल को देख लें। स्कूल की तस्वीरों से बनी यह छोटी, मूक फ़िल्म देखने के लिए टैप करें।')}</p>
  <a class="index-link" href={pathFor(lang,'gallery')}>{t('Open the school album', 'विद्यालय का एल्बम खोलें')} <span aria-hidden="true"><Arrow/></span></a></div>
  <VideoCard id="campus-spaces" lang={lang} large/>
</div></section>
<section class="life-directory"><div class="wrap life-directory-inner">
  <figure class="life-race"><Photo id="house-colour-chair-race" lang={lang} phoneMaxWidth={480} sizes="(min-width: 800px) 320px, 88vw"/><figcaption>{t('On the track at Sports Day, 2026', 'खेल दिवस, 2026 · दौड़ के मैदान में')}</figcaption></figure>
  <div><h2>{t('On the school team', 'एक टीम के साथी')}</h2><p>{t('See pupils in their house colours at Sports Day, follow the steps of an inter-house dance and meet our NCC cadets.', 'खेल दिवस पर सदनों के रंग, अंतर-सदनीय नृत्य के कदम और एनसीसी कैडेटों की तस्वीरें देखें।')}</p>
  <a class="index-link" href={pathFor(lang,'beyond')}>{t('Explore school life', 'स्कूल जीवन देखें')} <span aria-hidden="true"><Arrow/></span></a></div>
</div></section>
