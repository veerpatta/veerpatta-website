{
  // Cloudflare Workers (static assets) deployment for the Jekyll site.
  //
  // Jekyll builds into _site/ and Cloudflare uploads that directory as-is.
  // Almost every request is answered straight from that asset store. The one
  // exception is video: worker.js runs first for /assets/media/videos/* to
  // answer byte-range requests, which the asset store ignores and which
  // Safari on iPhone needs before it will play a clip.
  //
  // Workers Builds settings (set in the dashboard, not here):
  //   Build command:  (empty - see docs/DEPLOYMENT.md)
  //   Deploy command: npx wrangler deploy
  "name": "veerpatta-website",
  "compatibility_date": "2026-08-19",
  "main": "worker.js",

  // Explicit because wrangler warns on every deploy otherwise. This is the
  // default while a workers.dev route is enabled; stating it keeps branch and
  // pull-request preview URLs from silently changing behaviour later.
  "preview_urls": true,
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",

    // Only video goes through worker.js. Everything else never invokes it.
    "run_worker_first": ["/assets/media/videos/*"],

    // Serve the nearest 404.html with a real 404 status. Without this a
    // missing page returns 404 with no body; "single-page-application" would
    // be wrong here, since it answers 200 for every unmatched path and would
    // let search engines index soft 404s.
    "not_found_handling": "404-page"
  },

  // Workers tracing, per developers.cloudflare.com/agent-setup/tracing.md.
  //
  // Records only video requests, the only ones that run worker.js. Sampled
  // at 10% so a busy day does not flood the dashboard.
  "observability": {
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
