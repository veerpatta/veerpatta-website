# Jekyll Build Files
# _site/ is intentionally COMMITTED. Cloudflare deploys these files
# directly, so no Ruby toolchain runs on the deployment path. The
# GitHub Actions workflow rebuilds and commits it on every push.
# Do not re-add _site/ here without also restoring a Cloudflare build
# command, or deploys will ship stale HTML.
.sass-cache/
.jekyll-cache/
.jekyll-metadata

# Ruby/Bundler
.bundle/
vendor/
Gemfile.lock

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory

# Editors
.vscode/
.idea/
*.swp
*.swo
*.swn
*.bak
*~

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
*.tmp
*.temp
.cache/
tmp/

# Node.js (if ever needed)
node_modules/
package-lock.json
yarn.lock

# Environment variables
.env
.env.local
.env.*.local

# Build outputs
dist/
build/
out/

# Wrangler local state and cache (contains account identifiers)
.wrangler/
