{
  "name": "veerpatta-school-website",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/prepare-public.mjs && node scripts/astro.mjs dev --ignore-lock",
    "check": "node scripts/astro.mjs check",
    "build": "node scripts/prepare-public.mjs && node scripts/astro.mjs build && node scripts/check-site.mjs",
    "preview": "node scripts/astro.mjs preview --ignore-lock",
    "test": "node --experimental-strip-types --test tests/*.test.ts tests/*.test.cjs tests/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "astro": "7.4.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "typescript": "5.9.3",
    "@playwright/test": "1.65.0",
    "@axe-core/playwright": "4.11.1"
  }
}
